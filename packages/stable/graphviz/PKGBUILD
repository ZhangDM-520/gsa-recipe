# Contributor: Gaetan Bisson <bisson@archlinux.org>
# Contributor: kevin <kevin@archlinux.org>
# Contributor: John Proctor <jproctor@prium.net>

pkgname=graphviz
pkgver=16.1.1
pkgrel=1
pkgdesc='Graph visualization software'
url='https://www.graphviz.org/'
license=('EPL')
arch=('x86_64')
depends=('libltdl' 'gd' 'librsvg' 'ghostscript' 'pango' 'gts' 'gsfonts' 'aalib'
         'guile' 'lua' 'qt6-base' 'poppler-glib' 'r' 'ruby')
# bare soname provides for every sonamed ELF output (core libs + gvplugin
# loadable plugins); the swig/luarocks binding modules carry no sonames
provides=('libcdt.so' 'libcgraph.so' 'libgvc.so' 'libgvpr.so' 'libpathplan.so' 'libxdot.so'
          'libgvplugin_core.so' 'libgvplugin_dot_layout.so' 'libgvplugin_gd.so'
          'libgvplugin_gs.so' 'libgvplugin_kitty.so' 'libgvplugin_neato_layout.so'
          'libgvplugin_pango.so' 'libgvplugin_rsvg.so' 'libgvplugin_vt.so'
          'libgvplugin_webp.so' 'libgvplugin_xlib.so')
makedepends=('swig' 'mono' 'guile' 'lua' 'perl' 'python' 'r' 'tk' 'qt6-base')
optdepends=('mono: sharp bindings'
            'perl: perl bindings'
            'python: python bindings'
            'tcl: tcl bindings'
            'xterm: vimdot')
source=("https://gitlab.com/graphviz/graphviz/-/archive/$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('4cd5fb0d78bfd9a328006a777f385e1f4b4d873eec291307279ea3b15832299c')
b2sums=('3187264851833060eb165af49f0a0f8366ac18e06016a65ca3148d556dc3929565dd994785c9888de3b014ccbc71baddf20bc5e62291f1030ee2d91ecf4ebc82')
install='graphviz.install'

prepare() {
	cd "${srcdir}/${pkgname}-${pkgver}"
	./autogen.sh NOCONFIG
}

build() {
	cd "${srcdir}/${pkgname}-${pkgver}"

	export LIBPOSTFIX=/
	export CXXFLAGS+=' -fPIC -fpermissive'

	./configure --prefix=/usr --enable-python3=yes --disable-python --enable-lefty
        sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool # Fix overlinking
	make
}

package() {
	cd "${srcdir}/${pkgname}-${pkgver}"

	make DESTDIR="${pkgdir}" install

	# trim: man pages (docs) — stock dot2gxl man-symlink fix dropped together
	# with its /usr/share/man inputs
	rm -rf "${pkgdir}"/usr/share/man

	install -Dm644 LICENSE -t "${pkgdir}"/usr/share/licenses/$pkgname/

	# Deduplicates TCL libraries — the Tcl script dir tracks the system Tcl
	# major version (tcl8.6, tcl9.0, ...), so match any rather than hardcode
	local _tcl_lib
	for _tcl_lib in "${pkgdir}"/usr/lib/tcl*/; do
		[[ -d "$_tcl_lib/graphviz" ]] || continue
		rm -fr "$_tcl_lib/graphviz"
		ln -s ../graphviz/tcl "$_tcl_lib/graphviz"
	done
}
