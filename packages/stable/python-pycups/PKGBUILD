# Maintainer: Andrea Scarpino <andrea@archlinux.org>
# Contributor: nesl247 <nesl247@gmail.com>

pkgbase=pycups
pkgname=('python-pycups')
pkgver=2.0.4
pkgrel=5
arch=('x86_64')
url="https://github.com/OpenPrinting/pycups"
license=('GPL-2.0-or-later')
pkgdesc="Python bindings for libcups"
depends=('libcups' 'python' 'glibc')
makedepends=('python-setuptools')
provides=('pycups')
source=(${pkgname}-${pkgver}.tar.gz::https://github.com/OpenPrinting/pycups/archive/v${pkgver}.tar.gz
        'cups25-compat.h')
sha256sums=('31d9cf62df7884fe430d11970a8c9278282a47a0ff6b1529c58c7d26e8eb4789'
            '4533bd25a6e1b725c17ab7b079a79a868381e7efe316055fe03c49baf0ccd4cb')

build() {
  cd ${pkgbase}-${pkgver}
  # LDFLAGS from the environment).

  # cups 2.5 (libcups-git) installs headers under libcups2/ (cups/http.h →
  # libcups2/cups/http.h) and dropped cups-config; pyCUPS' setup.py assumes
  # the stock include layout and adds no -I of its own — take the include
  # flags from the capability's pkg-config metadata, never a hard-coded path.
  # The force-included compat header restores the legacy IPP/HTTP enum names
  # cups 2.5 renamed away (see the header's comment; JOURNAL 2026-10-18).
  export CFLAGS+=" $(pkg-config --cflags cups) -include \"$srcdir\"/cups25-compat.h"

  python setup.py build
}

package() {
  cd ${pkgbase}-${pkgver}
  python setup.py install --root="${pkgdir}" --optimize=1
  # house: licence re-homed to /usr/share/licenses (stock installs none)
  install -Dm644 COPYING "$pkgdir"/usr/share/licenses/$pkgname/COPYING
}
