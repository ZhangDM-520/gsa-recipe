# Maintainer: Antonio Rojas <arojas@archlinux.org>
# Maintainer: Bruno Pagani <archange@archlinux.org>

# trim: the kvantum-qt5 split and its Qt5 build tree (build5) are dropped
# together with the qt5-svg/qt5-tools/qt5-x11extras makedeps and its
# build5/style install path — this single-output recipe packages only kvantum
pkgname=kvantum
pkgver=1.1.9
pkgrel=1.1
pkgdesc='SVG-based theme engine for Qt6 (including config tool and extra themes)'
arch=(x86_64)
url='https://github.com/tsujan/Kvantum'
license=(GPL-3.0-or-later)
depends=(glibc
         libgcc
         libstdc++
         libx11
         kwindowsystem
         qt6-base
         qt6-svg)
makedepends=(cmake
             git
             qt6-svg
             qt6-tools)
optdepends=('kvantum-qt5: Qt5 style')
provides=(libkvantum.so)
source=(git+https://github.com/tsujan/Kvantum#tag=V$pkgver?signed)
sha256sums=('cf302658285cc053689c13baaea46778b5abae0b505ed00874e1dadef5a0dd9b')
validpgpkeys=(19DFDF3A579BD509DBB572D8BE793007AD22DF7E) # Pedram Pourang <tsujan2000@gmail.com>

build() {

  cmake -B build6 -S Kvantum/Kvantum \
    -DCMAKE_INSTALL_PREFIX=/usr
  make -C build6 -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  DESTDIR="$pkgdir" cmake --install build6

  # license: ship the upstream GPL-3.0-or-later text
  local _lic
  for _lic in LICENSE LICENSES COPYING; do
    if [[ -f Kvantum/$_lic ]]; then
      install -Dm644 "Kvantum/$_lic" -t "$pkgdir/usr/share/licenses/$pkgname/"
    elif [[ -d Kvantum/$_lic ]]; then
      # parent may not exist yet when only the LICENSES/ dir branch runs
      install -d "$pkgdir/usr/share/licenses/$pkgname/"
      cp -a "Kvantum/$_lic" "$pkgdir/usr/share/licenses/$pkgname/"
    fi
  done
}
