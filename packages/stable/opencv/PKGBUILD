pkgver=5.1.0
# 13.3: libopencv_sfm.so joins provides — the sfm module ships its soname
# (measured 2026-10-22 by tools/provides-audit.sh: "soname 'libopencv_sfm.so.500'
# is not declared in provides") and the bare stem is the house provides shape.
# 13.2: the python-opencv split output returns — 13.1 is the broken
# CachyOS string already installed on the host, and the same-version skip
# would silently leave it in place (pandoc-cli precedent)
pkgrel=4.1
pkgdesc='Open Source Computer Vision Library'
arch=(x86_64)
license=(Apache-2.0)
url='https://opencv.org/'
# google-glog, hdf5, jsoncpp, qt6-base, tesseract, vtk: the shipped payload
