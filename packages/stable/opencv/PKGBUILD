pkgname=(opencv python-opencv)
# trim: opencv-samples, opencv-cuda and python-opencv-cuda split outputs
# stay dropped (the build-cuda tree is not built; samples are not part of
# the maintained payload). python-opencv is a split output again (owner
# decision: split-in-opencv): the tree must own its bindings because the
# stock python-opencv rides a host vtk/jsoncpp mismatch
provides=(libopencv_alphamat.so libopencv_bgsegm.so libopencv_bioinspired.so
