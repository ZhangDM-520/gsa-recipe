# Maintainer: AndyRTR <andyrtr@archlinux.org>
# Contributor: Mantas Mikulėnas <grawity@gmail.com>

pkgname=gssproxy
pkgver=0.9.3
pkgrel=1.2
pkgdesc="GSSAPI Proxy"
arch=(x86_64)
url="https://github.com/gssapi/gssproxy"
license=('MIT')
depends=('libverto-module-base' 'popt' 'ding-libs' 'systemd-libs'
         'krb5' 'glibc')
makedepends=('libxslt' 'systemd' 'docbook-xsl')
# trim: po4a (man-page translations — the po4a rules in man/Makefile.am are
# commented out upstream) is dropped: purged tool, Class B purge lint; the
# doxygen makedep is dropped with the API docs (the stock recipe removed
# /usr/share/doc again in package()) — Class B trim standard (docs)
# trim: check() (make test_proxymech unit tests) — Class B trim standard
# (tests)
provides=('proxymech.so')
options=('emptydirs' 'makeflags')
backup=(etc/gssproxy/{gssproxy,24-nfs-server,80-httpd,99-network-fs-clients}.conf
        etc/gss/mech.d/proxymech.conf)
# v0.9.3 already contains 0001/0004/0005 (cherry-picked upstream before the
# release); applying them to this tarball is redundant and fails the hunks.
source=(https://github.com/gssapi/gssproxy/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz)
# https://github.com/gssapi/gssproxy/releases/download/v0.9.2/gssproxy-0.9.2.tar.gz.sha512sum.txt
sha512sums=('c5947eb7af4944d766cf9cff196d05ffc567e5162ffde36a5adaa7d147097709071e003748d4bb6396282ff8c7436863b8fb7863aad973ac7a9cd86856f2c0e6')

prepare() {
  cd "$srcdir/gssproxy-$pkgver"

  autoreconf -vfi
}

build() {
  CFLAGS+=" -std=gnu17" #fix build with gcc-15

  cd gssproxy-$pkgver

  ./configure --prefix=/usr \
    --sysconfdir=/etc  \
    --with-pubconf-path=/etc/gssproxy \
    --sbindir=/usr/bin \
    --localstatedir=/var \
    --without-selinux \
    --with-initscript=systemd \
    --with-gpp-default-behavior=REMOTE_FIRST
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  cd gssproxy-$pkgver
  make DESTDIR=$pkgdir install
  
  # cleanup empty directories
  rm -rf "$pkgdir"/usr/include
  rm -rf "$pkgdir"/usr/share/doc

  # trim: man pages (gssproxy.8/gssproxy.conf.5/gssproxy-mech.8) — Class B
  # trim standard (man); the libxslt/docbook-xsl generation tools stay (the
  # man_MANS are built by `make install` and only the payload is dropped)
  rm -rf "$pkgdir"/usr/share/man

  # install default config files
  install -m644 examples/gssproxy.conf "$pkgdir"/etc/gssproxy/gssproxy.conf
  # nfs services
  install -m644 examples/24-nfs-server.conf "$pkgdir"/etc/gssproxy/24-nfs-server.conf
  install -m644 examples/99-network-fs-clients.conf "$pkgdir"/etc/gssproxy/99-network-fs-clients.conf
  # httpd service / use Arch UID/GID http/33 (by pkg filesystem)
  install -m644 examples/80-httpd.conf "$pkgdir"/etc/gssproxy/80-httpd.conf
  sed -i -e "s:euid = apache:euid = http:" "$pkgdir"/etc/gssproxy/80-httpd.conf

#  install -Dm644 examples/mech  "$pkgdir"/etc/gss/mech.d/gssproxy.conf
  
  # FS#51574
  install -m700 -d ${pkgdir}/var/lib/gssproxy/rcache

  install -m755 -d ${pkgdir}/usr/share/licenses/$pkgname
  install -m644 COPYING ${pkgdir}/usr/share/licenses/$pkgname/
}

# vim:set sw=2 sts=-1 et:
