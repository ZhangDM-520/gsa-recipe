# The unit list has one home: the intent, through `genarch-settings units`. Restating it here
# would make a renamed unit need two more edits, and a reordered `[units]` a silent mismatch.
units() {
  /usr/bin/genarch-settings units 2>/dev/null || true
}

# 0.4.0 renamed the binary *and* the three live directories. The ownership record is what lets
# the new engine prune the five live files that changed name; without it they are orphaned and a
# stale unit stays a second writer for the same kernel attribute. Moved, never copied, and only
# when the destination is absent — an operator's apply in between must not be overwritten.
migrate_state() {
  local old new
  for pair in "/etc/genarch:/etc/genarch-settings" "/var/lib/genarch:/var/lib/genarch-settings"; do
    old="${pair%%:*}"
    new="${pair#*:}"
    if [ -d "$old" ] && [ ! -e "$new" ]; then
      mv "$old" "$new" && echo "genarch-settings: migrated $old -> $new"
    fi
  done
}

# The units this package used to deploy under the old names. `systemctl disable` needs the unit
# file still on disk, so this runs *before* the apply that prunes them.
disable_legacy_units() {
  systemctl disable --now genarch.service genarch-ceil.timer 2>/dev/null || true
  systemctl stop genarch.service genarch-ceil.service genarch-ceil.timer 2>/dev/null || true
}

pre_install() {
  migrate_state
}

pre_upgrade() {
  migrate_state
}

post_install() {
  # A legacy timer firing between the rename and the apply would write through a unit this
  # package is about to delete.
  disable_legacy_units
  # Deploy the intent's mirrors and units, then enable what the package wires up. The units
  # themselves ship as intent (one home), so they only exist after an apply. The apply also
  # prunes the legacy names, because the migrated manifest still lists them as owned.
  /usr/bin/genarch-settings apply || true
  systemctl daemon-reload
  udevadm control --reload || true
  enabled=$(units)
  if [ -n "$enabled" ]; then
    systemctl enable $enabled || true
  fi
}

post_upgrade() {
  post_install
}

pre_remove() {
  enabled=$(units)
  if [ -n "$enabled" ]; then
    systemctl disable $enabled 2>/dev/null || true
  fi
}
