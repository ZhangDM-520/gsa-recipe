# Maintainer: David Runge <dvzrv@archlinux.org>

pkgname=libopenmpt
pkgver=0.8.10
pkgrel=1.1
pkgdesc="A library to render tracker music to a PCM audio stream"
arch=(x86_64)
url="https://lib.openmpt.org/libopenmpt/"
license=(BSD-3-Clause)
depends=(
  flac
  glibc
  libgcc
  libogg  # required by pkgconf
  libpulse
  libsndfile
  libstdc++
  libvorbis
  mpg123
  portaudio
  zlib
)
makedepends=(
  autoconf-archive
  doxygen
  help2man
)
provides=(libopenmpt.so)
source=($pkgname-$pkgver.tar.gz::https://lib.openmpt.org/files/libopenmpt/src/$pkgname-$pkgver+release.autotools.tar.gz)
sha512sums=('c6eba868e1f9b65a1c8a4829b461ffe8a1411527336de31131e1f2494f271d2f364ec6f884cbcd93bea7dedb85e18a601fb4537ebdee8f7a3c1eb6116ca7d592')
b2sums=('64a287640f3aca1495a6f77391fdd7165c1b6c736bd7295595f9e7b8d3d0647c8c77eb9fc28427faa45541e178ad0a17f283770dd21882b2d9ed8e6d8759eb63')

prepare() {
  cd $pkgname-$pkgver+release.autotools
  autoreconf -fiv
}

build() {
  cd $pkgname-$pkgver+release.autotools

  ./configure --prefix=/usr
  # prevent excessive overlinking due to libtool
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

# trim: check() test suite (make check) — Class B trim standard (tests)

package() {
  cd $pkgname-$pkgver+release.autotools
  make DESTDIR="$pkgdir" install

  # trim: man pages, locales and doc payload (examples/README) — Class B
  # trim standard (man/locale/docs/examples); makedepends left stock
  # (help2man/doxygen feed the stock build, unverified at build time)
  rm -rf "$pkgdir"/usr/share/man "$pkgdir"/usr/share/locale "$pkgdir"/usr/share/doc

  install -vDm 644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
