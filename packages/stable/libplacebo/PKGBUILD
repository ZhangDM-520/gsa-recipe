# Maintainer: Levente Polyak <anthraxx[at]archlinux[dot]org>
# Maintainer: Robin Candau <antiz@archlinux.org>

pkgname=libplacebo
pkgver=7.387.0
# stock packaging stamps pkgrel 1.1, so this build must strictly beat the
# installed stamp — a delta that merely differs is skipped as not-newer
# (AGENTS.md §5, `stock+.1` pkgrel delta)
pkgrel=1.2
pkgdesc='Reusable library for GPU-accelerated video/image rendering primitives'
arch=(x86_64)
url='https://github.com/haasn/libplacebo'
license=('LGPL-2.1-or-later')
depends=('vulkan-icd-loader' 'glslang' 'lcms2' 'shaderc'
         'glibc' 'libgcc' 'libstdc++' 'libunwind' 'libdovi' 'xxhash')
makedepends=(meson ninja python python-jinja python-markupsafe python-setuptools
             glad vulkan-headers libglvnd)
provides=('libplacebo.so')
source=("https://code.videolan.org/videolan/libplacebo/-/archive/v${pkgver}/libplacebo-v${pkgver}.tar.gz")
sha512sums=('57db9dd1526345dd95033fb4ae0db0ae8ae311973a3159307b67fd5504dad7810ed406f76c8ab7e952f7556e598cccaeb4abe6d2f5f623a73ed63418442337ae')
b2sums=('e0b25ca4af9c4e318ea33b1db3bf20b2e2a8aae153e7e896856e65d14a1c1b3a2dba96d216c01de568d1f23499257cdc3ca13fdb6ecb7c8e2cc705be232c3d9d')

build() {
  cd "$pkgname-v$pkgver"

  local _meson_options=(
    # the GPU-backend set the maintained renderers need; d3d11 is Windows-only
    # and demos pull the nuklear subproject, which is not packaged here
    -Dvulkan=enabled
    -Dglslang=enabled
    -Dshaderc=enabled
    -Dlcms=enabled
    -Dlibdovi=enabled
    -Dd3d11=disabled
    -Ddemos=false
    -Dtests=true
  )

  arch-meson build "${_meson_options[@]}"
  meson compile -C build
}

check() {
  cd "$pkgname-v$pkgver"
  meson test -C build --print-errorlogs
}

package() {
  # rule-54: the shipped ELF links these sonames directly (measured with
  # `readelf -d`); bare stems are auto-versioned from the packaged soname
  depends+=('libdovi.so' 'liblcms2.so' 'libshaderc_shared.so' 'libvulkan.so')

  cd "$pkgname-v$pkgver"
  meson install -C build --destdir "$pkgdir"

  # trim: the upstream README lands as /usr/share/doc payload only
  # (Class B trim standard, docs)
  rm -rf "$pkgdir"/usr/share/doc

  install -Dm644 "$srcdir/$pkgname-v$pkgver/LICENSE" \
    "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}
