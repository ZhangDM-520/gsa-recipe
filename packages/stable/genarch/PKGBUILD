# Maintainer: ZhangDM-520 <jixianqianqiang1540@gmail.com>
# The engine is this host's sole writer for its power/IO configuration: it ships the intent
# (typed TOML, byte-exact mirrors for opaque files, anchored-line records for foreign files),
# judges live against it read-only, and converges. One path has one owner, and the engine
# refuses to become a second writer for a file another engine already owns.
#
# The intent is layered: a host-agnostic base, this machine's profile, and an operator override.
# The package ships this host's profile AND its selection (/etc/genarch/profile, a backup file);
# a host whose DMI does not match reports PROFILE DRIFT instead of silently applying another
# machine's facts.
#
# Units and udev rules ship AS INTENT, not as packaged files: the engine deploys every mirror
# through one mechanism, so `genarch apply` in post_install is what creates them. That is a
# deliberate one-home rule, not a missing file list -- do not add separate unit installs here.
#
# Source: the tagged release. This tree is one machine's working configuration, so the tag is
# the only reviewable artifact; an untagged checkout is not what gets packaged.
pkgname=genarch
pkgver=0.2.0
pkgrel=1
pkgdesc="Native tuning engine: layered intent, machine profiles, read-only judge, converge pass"
arch=('x86_64')
url="https://github.com/ZhangDM-520/genarch-settings"
license=('MIT')
# systemd: units are deployed by post_install; ryzenadj+iw+wireless-regdb: the SMU, WiFi and
# regulatory rows the intent drives. gcc-libs: the Rust binary's runtime.
depends=('gcc-libs' 'systemd' 'ryzenadj' 'iw' 'wireless-regdb')
makedepends=('git' 'cargo' 'rust')
install=genarch.install
backup=('etc/genarch/profile')
options=('!lto')
source=("git+$url#tag=v$pkgver")
sha256sums=('SKIP')

build() {
  cd "$srcdir/genarch-settings"
  cargo build --release --locked
}

package() {
  cd "$srcdir/genarch-settings"
  install -Dm755 target/release/genarch "$pkgdir/usr/bin/genarch"

  # The intent is package data: the engine reads it and never writes it. Copied whole, so a new
  # typed file (ceil.toml) or a new profile does not need an edit here.
  install -Dm644 Cargo.toml "$pkgdir/usr/lib/genarch/package.toml"
  cp -a intent/. "$pkgdir/usr/lib/genarch/"

  # Built for this host, so it selects this host's profile.
  install -d "$pkgdir/etc/genarch"
  printf 'profile = "zenbook-s16"\n' > "$pkgdir/etc/genarch/profile"
  chmod 644 "$pkgdir/etc/genarch/profile"

  for doc in AGENTS.md CONTEXT.md SCOPE.md CONTRIBUTING.md LICENSE; do
    install -Dm644 "$doc" "$pkgdir/usr/share/doc/genarch/$doc"
  done
  install -Dm644 docs/DESIGN.md "$pkgdir/usr/share/doc/genarch/DESIGN.md"
  # The pacman-free path for a host without this recipe lives in the source tree, so the recipe
  # no longer carries a copy that can drift from it.
  install -Dm755 install.sh "$pkgdir/usr/share/doc/genarch/install.sh"
}
