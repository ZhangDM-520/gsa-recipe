# The units exist only after the first apply (they are shipped as intent), so the post-install
# step is the deployment, not a convenience.
post_install() {
  /usr/bin/genarch apply || true
  systemctl daemon-reload
  udevadm control --reload || true
  systemctl enable genarch.service genarch-ceil.timer || true
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl disable genarch.service genarch-ceil.timer 2>/dev/null || true
}
