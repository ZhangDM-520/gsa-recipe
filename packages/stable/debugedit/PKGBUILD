pkgname=debugedit
pkgver=5.4
pkgrel=1
pkgdesc='Tool to mangle source locations in .debug files'
arch=('x86_64')
url='https://sourceware.org/debugedit/'
license=('GPL-3.0-or-later' 'GPL-2.0-or-later' 'LGPL-2.0-or-later')
depends=('glibc' 'libelf' 'xxhash' 'cpio' 'elfutils' 'gdb')
source=("https://sourceware.org/ftp/debugedit/${pkgver}/debugedit-${pkgver}.tar.xz"{,.sig}
        "remove-dwz.patch")
validpgpkeys=(
    '28FF4B30A88D5523A7E2CBA20376A15C6FFC11CD' # Mark J. Wielaard <mark@klomp.org>
)
sha512sums=('a5813796779f7a09c4845b4d995296692d88ab8fe889c7c97b1f868dec4b6f9c426bcb18dd051a6f49e2275d553374103460c1b700e78c4db7dc7eafd4c55342'
            'SKIP'
            'fe10d161fffd392d8ac86d439eaac267955a81ca2bb68d4218aa585fab6ca07b9ecb12f146050077bf82f95d1c93cbf6e916eec5713efb729f26f53b74677b15')

prepare() {
    cd "debugedit-${pkgver}"
    patch -Np1 < "$srcdir/remove-dwz.patch"
    autoreconf -fiv
}

build() {
    cd "debugedit-${pkgver}"
    ./configure --prefix=/usr
    # trim: the man pages are dropped in package() — pre-empt their help2man
    # generation rules (help2man is not a host tool here) by marking the
    # targets up-to-date; `make install` ships them empty and package()
    # removes the man tree. The rules only fire when the .c/.in or
    # configure.ac are newer than the target, so a post-configure touch
    # holds through install.
    touch debugedit.1 sepdebugcrcfix.1 debugedit-classify-ar.1 find-debuginfo.1
    make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
    cd "debugedit-${pkgver}"
    make DESTDIR="${pkgdir}" install

    # trim: man pages (docs) — not part of the maintained target
    rm -rf "${pkgdir}"/usr/share/man

    install -Dm644 COPYING COPYING3 COPYING.LIB -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
