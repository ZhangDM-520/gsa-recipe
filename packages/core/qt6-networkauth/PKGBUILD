# Maintainer: Antonio Rojas <arojas@archlinux.org>
# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=qt6-networkauth
# placeholder — overridden by pkgver() (git describe on dev branch)
pkgver=6.13.0_r1541.g999040e
pkgrel=1
arch=(x86_64)
url='https://www.qt.io'
license=(GPL-3.0-only
         LGPL-3.0-only
         LicenseRef-Qt-Commercial
         Qt-GPL-exception-1.0)
pkgdesc='Qt Network Authorization module'
depends=(glibc
         libstdc++
         qt6-base)
makedepends=(cmake
             git
             ninja)
groups=(qt6)
provides=(libQt6NetworkAuth.so)
_pkgfn=${pkgname/6-/}
source=(git+https://code.qt.io/qt/$_pkgfn#branch=dev)
sha256sums=('SKIP')

build() {
  cmake -B build -S $_pkgfn -G Ninja \
    -DCMAKE_MESSAGE_LOG_LEVEL=STATUS \
    -DQT_BUILD_TESTS=OFF \
    -DQT_BUILD_EXAMPLES=OFF
  cmake --build build --parallel "${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -d "$pkgdir"/usr/share/licenses
  ln -s /usr/share/licenses/qt6-base "$pkgdir"/usr/share/licenses/$pkgname
}

pkgver() {
  cd $_pkgfn
  # git describe is UNUSABLE on Qt dev branches: release tags live on the
  # 'release' branch, not in dev ancestry — read the module version from
  # .cmake.conf instead (qt6-svg precedent).
  _ver="$(grep -m1 -oP 'QT_REPO_MODULE_VERSION\s+"?\K[0-9][0-9.]*' .cmake.conf)"
  echo "${_ver}_r$(git rev-list --count HEAD).g$(git rev-parse --short HEAD)"
}
