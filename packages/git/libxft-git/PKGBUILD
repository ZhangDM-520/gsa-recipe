# Contributor: bud <at budlabs>

# git recipe tracking the upstream xorg libXft VCS (AUR libxft-git used as
# reference only)

pkgname=libxft-git
pkgver=2.3.9.r8.g9a44b29
pkgrel=1
pkgdesc='FreeType-based font drawing library for X (git build)'
arch=('x86_64')
url='https://gitlab.freedesktop.org/xorg/lib/libxft'
license=('HPND-sell-variant')
depends=('fontconfig' 'freetype2' 'glibc' 'libx11' 'libxrender' 'xorgproto')
makedepends=('git' 'xorg-util-macros')
provides=("libxft=$pkgver" 'libXft.so')
conflicts=('libxft')
source=('git+https://gitlab.freedesktop.org/xorg/lib/libxft.git#commit=9a44b29c1e35fbb78c50cdb855bf4f210e5a676d')
b2sums=('SKIP')

pkgver() {
  cd libxft
  git describe --long --tags | sed 's/^libXft-//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  cd libxft
  autoreconf -fvi
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --disable-static
  make -j"${GSA_BUILD_JOBS:-$(getconf _NPROCESSORS_ONLN)}"
}

package() {
  cd libxft
  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}
