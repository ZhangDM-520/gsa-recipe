pkgname=wayland-protocols-git
pkgver=1.50.r0.g3eab2dc
pkgrel=1
pkgdesc='Wayland protocols that add functionalities not available in the core protocol (git build)'
arch=('any')
url='https://wayland.freedesktop.org/'
license=('MIT')
makedepends=('git' 'wayland' 'meson')
conflicts=('wayland-protocols')
provides=("wayland-protocols=$pkgver")
# data-only package — no shared libs, no soname provides. Stock verifies
# signed release tarballs; git master carries no verifiable signed tag for a
# ?signed source (makepkg would run `git verify-commit HEAD`) — tracked
# unsigned, no --skippgpcheck
source=('wayland-protocols::git+https://gitlab.freedesktop.org/wayland/wayland-protocols.git')
b2sums=('SKIP')

pkgver() {
  cd wayland-protocols
  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {

  arch-meson wayland-protocols build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 wayland-protocols/COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}
