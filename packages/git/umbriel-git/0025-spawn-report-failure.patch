+fi
+if ! grep -q "umbriel-harness-no-such-program-$$" "$UMBRIEL_RUNTIME_DIR/spawn-missing.err"; then
+  echo "the failure did not name the missing program: $(< "$UMBRIEL_RUNTIME_DIR/spawn-missing.err")"
+  exit 1
