+  const auto uprightOf = [](const wlr_fbox& box, wl_output_transform transform, int bufferWidth, int bufferHeight) {
+    wlr_fbox upright = box;
+    if (transform != WL_OUTPUT_TRANSFORM_NORMAL) {
+      wlr_fbox_transform(&upright, &box, transform, bufferWidth, bufferHeight);
+    }
+    return upright;
+  };
+
+  const wlr_fbox straight =
+      titleBarStripSourceBox(full, 400, 300, {10, 20, 380, 260}, 400, 300, WL_OUTPUT_TRANSFORM_NORMAL, 5);
+  CHECK_EQ(straight.x, 10.0);
+  CHECK_EQ(straight.y, 20.0);
+  CHECK_EQ(straight.width, 380.0);
+  CHECK_EQ(straight.height, 5.0);
+
+  // Every transform, flips included, and an off-centre geometry: a crop mirrored about the buffer centre would pass a
+  // symmetric one, and a dropped flip bit only shows up once the offset is off-centre.
+  for (const wl_output_transform transform :
+       {WL_OUTPUT_TRANSFORM_90, WL_OUTPUT_TRANSFORM_180, WL_OUTPUT_TRANSFORM_270, WL_OUTPUT_TRANSFORM_FLIPPED,
+        WL_OUTPUT_TRANSFORM_FLIPPED_90, WL_OUTPUT_TRANSFORM_FLIPPED_180, WL_OUTPUT_TRANSFORM_FLIPPED_270}) {
+    const auto rotation = static_cast<wl_output_transform>(transform & 3U);
+    const bool quarterTurn = rotation == WL_OUTPUT_TRANSFORM_90 || rotation == WL_OUTPUT_TRANSFORM_270;
+    const int surfaceWidth = quarterTurn ? 300 : 400;
+    const int surfaceHeight = quarterTurn ? 400 : 300;
+    const wlr_box geometry = quarterTurn ? wlr_box{10, 20, 100, 380} : wlr_box{10, 20, 100, 260};
+    const wlr_fbox strip = titleBarStripSourceBox(full, 400, 300, geometry, surfaceWidth, surfaceHeight, transform, 5);
+    const wlr_fbox upright = uprightOf(strip, transform, 400, 300);
+    CHECK_NEAR(upright.x, 10.0, 0.001);
+    CHECK_NEAR(upright.y, 20.0, 0.001);
+    CHECK_NEAR(upright.width, static_cast<double>(geometry.width), 0.001);
+    CHECK_NEAR(upright.height, 5.0, 0.001);
+  }
+
+  // At an output scale the shadow margin and the strip are both in surface pixels, so both double in the buffer.
+  const wlr_fbox scaled = titleBarStripSourceBox(
+      {0.0, 0.0, 800.0, 600.0}, 800, 600, {10, 20, 280, 380}, 300, 400, WL_OUTPUT_TRANSFORM_90, 5
+  );
+  const wlr_fbox scaledUpright = uprightOf(scaled, WL_OUTPUT_TRANSFORM_90, 800, 600);
+  CHECK_NEAR(scaledUpright.x, 20.0, 0.001);
+  CHECK_NEAR(scaledUpright.y, 40.0, 0.001);
+  CHECK_NEAR(scaledUpright.width, 560.0, 0.001);
+  CHECK_NEAR(scaledUpright.height, 10.0, 0.001);
+
+  // A geometry that misses the visible part leaves the whole surface visible, as an unset one does.
+  const wlr_fbox outside =
+      titleBarStripSourceBox(full, 400, 300, {-40, -60, 10, 10}, 400, 300, WL_OUTPUT_TRANSFORM_NORMAL, 5);
+  CHECK_EQ(outside.x, 0.0);
+  CHECK_EQ(outside.y, 0.0);
+  CHECK_EQ(outside.width, 400.0);
+  CHECK_EQ(outside.height, 5.0);
+}
+
 int main() { return RUN_TESTS(); }
diff --git a/tests/unit/title_bar_contrast.cpp b/tests/unit/title_bar_contrast.cpp
new file mode 100644
index 00000000..b43be8eb
--- /dev/null
+++ b/tests/unit/title_bar_contrast.cpp
@@ -0,0 +1,71 @@
+#include "scene/title_bar_contrast.h"
+
+#include "check.h"
+
+#include <array>
+
+namespace {
+  constexpr std::array<float, 4> colour(float red, float green, float blue, float alpha = 1.0F) {
+    return {red, green, blue, alpha};
+  }
+} // namespace
+
+UMBRIEL_TEST(luminanceRanksColoursByPerceivedBrightness) {
+  CHECK(umbriel::luminance(colour(0.0F, 0.0F, 0.0F)) < umbriel::luminance(colour(0.5F, 0.5F, 0.5F)));
+  CHECK(umbriel::luminance(colour(0.5F, 0.5F, 0.5F)) < umbriel::luminance(colour(1.0F, 1.0F, 1.0F)));
+  // Green reads brighter than blue at the same intensity, which is why the weights are not equal.
+  CHECK(umbriel::luminance(colour(0.0F, 1.0F, 0.0F)) > umbriel::luminance(colour(0.0F, 0.0F, 1.0F)));
+}
+
+UMBRIEL_TEST(contrastAdjustedKeepsAColourThatAlreadyReads) {
+  // Light text on a dark bar is the ordinary case: it survives untouched, alpha included.
+  const auto light = colour(0.93F, 0.93F, 0.95F, 0.8F);
+  CHECK(umbriel::contrastAdjusted(light, colour(0.16F, 0.16F, 0.2F)) == light);
+  const auto dark = colour(0.1F, 0.1F, 0.12F, 1.0F);
+  CHECK(umbriel::contrastAdjusted(dark, colour(0.9F, 0.9F, 0.9F)) == dark);
+}
+
+UMBRIEL_TEST(contrastAdjustedReversesIntoALightBar) {
+  // Dark text on a bar the window painted dark: the title flips to white, keeping its own alpha.
+  const auto text = colour(0.15F, 0.15F, 0.15F, 0.75F);
+  const auto adjusted = umbriel::contrastAdjusted(text, colour(0.2F, 0.2F, 0.25F));
+  CHECK_EQ(adjusted[0], 1.0F);
+  CHECK_EQ(adjusted[1], 1.0F);
+  CHECK_EQ(adjusted[2], 1.0F);
+  CHECK_EQ(adjusted[3], 0.75F);
+}
+
+UMBRIEL_TEST(contrastAdjustedReversesIntoADarkBar) {
+  const auto text = colour(0.85F, 0.85F, 0.85F, 1.0F);
+  const auto adjusted = umbriel::contrastAdjusted(text, colour(0.8F, 0.82F, 0.8F));
+  CHECK_EQ(adjusted[0], 0.0F);
+  CHECK_EQ(adjusted[1], 0.0F);
+  CHECK_EQ(adjusted[2], 0.0F);
+  CHECK_EQ(adjusted[3], 1.0F);
+}
+
+UMBRIEL_TEST(contrastAdjustedFlipsOnlyBelowTheThreshold) {
+  // Just under the threshold reverses; just above it the configured colour stands. The boundary itself is not pinned:
+  // both sides of it are computed luminances, so no case sits exactly on it.
+  const auto text = colour(0.0F, 0.0F, 0.0F, 1.0F);
+  const float justUnder = umbriel::kTitleContrastThreshold - 0.01F;
+  const float justOver = umbriel::kTitleContrastThreshold + 0.01F;
+  const auto reversed = umbriel::contrastAdjusted(text, colour(justUnder, justUnder, justUnder));
+  CHECK_EQ(reversed[0], 1.0F);
+  CHECK(umbriel::contrastAdjusted(text, colour(justOver, justOver, justOver)) == text);
+}
+
+UMBRIEL_TEST(contrastAdjustedLeavesAnInvisibleTitleAlone) {
+  // An alpha of zero is how a palette hides the title. Reversing it would leave a bright colour behind a transparent
+  // composite, which the renderer cannot mask away.
+  const auto hidden = colour(0.1F, 0.1F, 0.1F, 0.0F);
+  CHECK(umbriel::contrastAdjusted(hidden, colour(0.1F, 0.1F, 0.1F)) == hidden);
+}
+
+UMBRIEL_TEST(contrastAdjustedLeavesATitleAloneOnNoBackground) {
+  // A bar with no alpha is not what shows, so its colour says nothing about what the title sits on.
+  const auto text = colour(0.1F, 0.1F, 0.1F, 1.0F);
+  CHECK(umbriel::contrastAdjusted(text, colour(0.1F, 0.1F, 0.1F, 0.0F)) == text);
+}
+
+int main() { return RUN_TESTS(); }
diff --git a/umbrielfx/include/umbrielfx/types/wlr_scene.h b/umbrielfx/include/umbrielfx/types/wlr_scene.h
index 5597b1d6..cfb77fd9 100644
--- a/umbrielfx/include/umbrielfx/types/wlr_scene.h
+++ b/umbrielfx/include/umbrielfx/types/wlr_scene.h
@@ -993,6 +993,14 @@ void wlr_scene_buffer_set_buffer_with_options(
     const struct wlr_scene_buffer_set_buffer_options* options
 );
 
+/**
+ * Marks a client buffer as safe for in-place shm damage even though another scene buffer keeps a lock on it, the way
+ * wlr_scene_surface marks its own lock, and returns the client buffer to undo the mark with. Returns NULL when
+ * `buffer` is not a client buffer, or is a single-pixel buffer whose colour the scene caches.
+ */
+struct wlr_client_buffer* umbrielfx_scene_buffer_ignore_client_lock(struct wlr_buffer* buffer);
+void umbrielfx_scene_buffer_drop_ignored_client_lock(struct wlr_client_buffer* buffer);
+
 /**
  * Sets the buffer's opaque region. This is an optimization hint used to
  * determine if buffers which reside under this one need to be rendered or not.
diff --git a/umbrielfx/types/scene/surface.c b/umbrielfx/types/scene/surface.c
index bd79dda4..7226c2da 100644
--- a/umbrielfx/types/scene/surface.c
+++ b/umbrielfx/types/scene/surface.c
@@ -225,6 +225,27 @@ static void scene_buffer_unmark_client_buffer(struct wlr_scene_buffer* scene_buf
   }
 }
 
+struct wlr_client_buffer* umbrielfx_scene_buffer_ignore_client_lock(struct wlr_buffer* buffer) {
+  if (buffer == NULL) {
+    return NULL;
+  }
+  struct wlr_client_buffer* client = wlr_client_buffer_get(buffer);
+  // The wrapper's own impl is the client-buffer one; the single-pixel check needs the source the client committed,
+  // and a wrapper can carry none. Same shape as scene_surface_set_buffer() below.
+  if (client == NULL
+      || (client->source != NULL && wlr_single_pixel_buffer_v1_try_from_buffer(client->source) != NULL)) {
+    return NULL;
+  }
+  client_buffer_mark_next_can_damage(client);
+  return client;
+}
+
+void umbrielfx_scene_buffer_drop_ignored_client_lock(struct wlr_client_buffer* buffer) {
+  if (buffer != NULL && buffer->n_ignore_locks > 0) {
+    buffer->n_ignore_locks--;
+  }
+}
+
 static int min(int a, int b) { return a < b ? a : b; }
 
 static int max(int a, int b) { return a > b ? a : b; }
