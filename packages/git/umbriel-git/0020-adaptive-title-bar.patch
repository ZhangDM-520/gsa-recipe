diff --git a/tests/harness/checks/overview/card_title_bar.sh b/tests/harness/checks/overview/card_title_bar.sh
new file mode 100755
index 00000000..e02312ab
--- /dev/null
+++ b/tests/harness/checks/overview/card_title_bar.sh
@@ -0,0 +1,135 @@
+#!/usr/bin/env bash
+# harness: outputs=1
+# An overview card paints what its window resolved rather than reading it again per card: the mean of an "average" bar,
+# and the contrast decision of a "window" bar whose edge is read as empty. Only a palette change may paint the palette.
+set -euo pipefail
+source "$UMBRIEL_HARNESS_LIB"
+
+readonly CLIENT="${UMBRIEL_UNMAP_CLIENT:-./build-debug/tests/unmap-client}"
+readonly LOG="$UMBRIEL_RUNTIME_DIR/card-title-bar.log"
+readonly SHOT="$UMBRIEL_RUNTIME_DIR/card-title-bar.png"
+readonly FIFO="$UMBRIEL_RUNTIME_DIR/card-title-bar.fifo"
+
+fail() {
+  echo "$1"
+  exit 1
+}
+
+# $1 color_source, $2 extra [appearance.title_bar] lines
+configure() {
+  cat > "$UMBRIEL_CONFIG" <<EOF
+[general]
+xwayland = false
+show_cheatsheet = false
+autostart = []
+
+[output.HEADLESS-1]
+scale = 1.0
+
+[animation]
+enabled = false
+
+[appearance]
+border_width = 0
+outer_border_width = 0
+corner_radius = 0
+
+[appearance.shadow]
+enabled = false
+
+[appearance.blur]
+enabled = false
+
+[appearance.title_bar]
+mode = "forced"
+height = 28
+color_source = "$1"
+color_source_height = 1
+button_background = false
+button_glyph = "never"
+title_shadow = false
+${2:-}
+
+[colors.title_bar]
+background = "$3"
+background_unfocused = "$3"
+text = "$4"
+text_unfocused = "$4"
+
+[colors]
+backdrop = "#000000FF"
+
+[colors.overview]
+background_tint = "#000000FF"
+workspace_background = "#000000FF"
+
+[overview]
+zoom = 0.5
+
+[[window_rule]]
+match.title = "^card-fill\$"
+default_floating = true
+default_floating_size_px = { width = 480, height = 300 }
+default_position = { x = 173, y = 109, anchor = "top_left" }
+EOF
+  "$UMBRIEL" msg config-reload > /dev/null
+}
+
+# The card is the window scaled by the overview zoom and placed above its workspace row: a 480x300 window at zoom 0.5
+# puts its 28 px bar here, so counting this row alone separates the card from the live window below it.
+readonly CARD_BAR="236x14+522+185"
+
+count() { "$UMBRIEL_PIXEL_PROBE" "$SHOT" count "$1" "$CARD_BAR"; }
+
+expect_at_least() {
+  local pattern=$1 minimum=$2 what=$3 found
+  found=$(count "$pattern")
+  ((found >= minimum)) || fail "$what: only $found pixels match '$pattern'"
+}
+
+expect_none() {
+  local pattern=$1 what=$2 found
+  found=$(count "$pattern")
+  ((found == 0)) || fail "$what: $found pixels still match '$pattern'"
+}
+
+# The mean of a light top edge, which the magenta palette cannot reach; the palette itself, which must not paint the bar
+# while the mean is known; and the white a title reverses to on a dark bar.
+readonly mean='r > 0.85 && r < 0.98 && g > 0.85 && g < 0.98 && b > 0.85 && b < 0.98'
+readonly palette='r > 0.8 && g < 0.15 && b > 0.8'
+readonly white='r > 0.98 && g > 0.98 && b > 0.98'
+
+[[ -x $CLIENT ]] || fail "unmap client is not built"
+
+# A reload can close the overview, so each card is captured from a close/open pair rather than assumed to be on screen.
+shoot_card() {
+  "$UMBRIEL" msg overview-close > /dev/null
+  "$UMBRIEL" settle
+  "$UMBRIEL" msg overview-open > /dev/null
+  "$UMBRIEL" settle
+  grim -o HEADLESS-1 "$SHOT"
+}
+
+# The rule has to be in place before the client maps: a reload does not re-place a mapped window.
+configure average 'title_contrast = false' '#FF00FFFF' '#202020FF'
+mkfifo "$FIFO"
+FILL_COLOR=0xFF202020 TOP_BAND_COLOR=0xFFF0F0F0 TOP_BAND_HEIGHT=1 REPAINT_ON_STDIN=1 \
+  "$CLIENT" card-title-bar 480 300 < "$FIFO" > "$LOG" 2>&1 &
+exec 3> "$FIFO"
+for _ in $(seq 80); do
+  [[ $("$UMBRIEL" windows --json | jq length) -eq 1 ]] && break
+  sleep 0.025
+done
+[[ $("$UMBRIEL" windows --json | jq length) -eq 1 ]] || fail "the card client never mapped"
+
+# The card carries the mean its window read; a card that dropped it falls back to the palette underneath.
+shoot_card
+expect_at_least "$mean" 800 "the card's averaged bar"
+expect_none "$palette" "the palette painted the card's bar over the mean"
+
+# The control: the same card under a palette it has to fall back to, which proves the assertion above is not vacuous.
+configure fixed 'title_contrast = false' '#FF00FFFF' '#202020FF'
+shoot_card
+expect_at_least "$palette" 800 "the card's palette bar in fixed mode"
+
+echo "an overview card paints the bar its window resolved, and the palette only when nothing was resolved"
diff --git a/tests/harness/checks/render/title_bar_adaptive.sh b/tests/harness/checks/render/title_bar_adaptive.sh
new file mode 100755
index 00000000..5d4d92b4
--- /dev/null
+++ b/tests/harness/checks/render/title_bar_adaptive.sh
@@ -0,0 +1,320 @@
+#!/usr/bin/env bash
+# `color_source` takes the bar's fill from the window instead of the palette: "window" mirrors its top rows, "average"
+# paints their mean. The window paints its first row green over a red body, so a bar sampling anything else shows red.
+# The readback cadence and the explicit-sync bound are pinned in tests/unit/adaptive_sampling.cpp: this client commits
+# twice per repaint (the frame request and the frame callback), so a readback count per repaint is not a stable
+# observable here.
+set -euo pipefail
+source "$UMBRIEL_HARNESS_LIB"
+
+readonly CLIENT="${UMBRIEL_UNMAP_CLIENT:-./build-debug/tests/unmap-client}"
+readonly LOG="$UMBRIEL_RUNTIME_DIR/adaptive-bar.log"
+readonly FRAME="$UMBRIEL_RUNTIME_DIR/adaptive-bar.png"
+# The floating window is 480x300 at 173,109, so its 28 px bar covers 173..653 by 81..109. The title text is drawn
+# transparent and the buttons paint nothing, so this crop inside the bar reads the fill alone.
+readonly BAR="120x10+233+87"
+# The whole bar: x 173..653 by y 81..109, inset by a pixel, covering the title and every button slot.
+readonly BAR_FULL="474x26+175+82"
+
+fail() {
+  echo "$1"
+  exit 1
+}
+
+# $1 color_source, $2 title colour (default transparent), $3 "closing" to enable a fade-out the checks can
+# sample, $4 "buttons" to paint the button backgrounds, $5 rows of the window's edge to sample.
+configure() {
+  local source=$1 text=${2:-"#00000000"} closing=${3:-} buttons=${4:-} rows=${5:-1} radius=${6:-0}
+  {
+    cat <<EOF
+[general]
+xwayland = false
+show_cheatsheet = false
+autostart = []
+
+[output.HEADLESS-1]
+scale = 1.0
+
+[animation]
+EOF
+    if [[ $closing == closing ]]; then
+      cat <<'EOF'
+duration_ms = 1000
+curve = "linear"
+
+[animation.windows_out]
+style = "fade"
+EOF
+    else
+      echo 'enabled = false'
+    fi
+    cat <<EOF
+
+[appearance]
+border_width = 0
+outer_border_width = 0
+corner_radius = $radius
+
+[appearance.title_bar]
+mode = "forced"
+height = 28
+color_source = "$source"
+color_source_height = $rows
+button_background = $(if [[ $buttons == buttons ]]; then echo true; else echo false; fi)
+button_glyph = "never"
+
+[appearance.shadow]
+enabled = false
+
+[appearance.blur]
+enabled = false
+
+[colors.title_bar]
+background = "#FF00FFFF"
+background_unfocused = "#FF00FFFF"
+text = "$text"
+text_unfocused = "$text"
+$(if [[ $buttons == buttons ]]; then printf 'close = "#FF0000FF"\nmaximize = "#FF0000FF"\nminimize = "#FF0000FF"'; fi)
+
+[[window_rule]]
+match.title = "^adaptive-bar\$"
+default_floating = true
+default_floating_size_px = { width = 480, height = 300 }
+default_position = { x = 173, y = 109, anchor = "top_left" }
+EOF
+  } > "$UMBRIEL_CONFIG"
+  "$UMBRIEL" msg config-reload > /dev/null
+}
+
+# Pixels in the bar crop matching a predicate.
+count() { "$UMBRIEL_PIXEL_PROBE" "$FRAME" count "$1" "$BAR"; }
+count_in() { "$UMBRIEL_PIXEL_PROBE" "$FRAME" count "$1" "$2"; }
+pixel() { "$UMBRIEL_PIXEL_PROBE" "$FRAME" pixel "$1" "$2"; }
+
+expect() {
+  local predicate=$1 minimum=$2 what=$3 found
+  found=$(count "$predicate")
+  if ((found < minimum)); then
+    fail "$what: only $found pixels match '$predicate'"
+  fi
+}
+
+expect_none() {
+  local predicate=$1 what=$2 found
+  found=$(count "$predicate")
+  if ((found != 0)); then
+    fail "$what: $found pixels still match '$predicate'"
+  fi
+}
+
+expect_none_in() {
+  local predicate=$1 crop=$2 what=$3 found
+  found=$(count_in "$predicate" "$crop")
+  if ((found != 0)); then
+    fail "$what: $found pixels match '$predicate' inside $crop"
+  fi
+}
+
+expect_in() {
+  local predicate=$1 crop=$2 minimum=$3 what=$4 found
+  found=$(count_in "$predicate" "$crop")
+  if ((found < minimum)); then
+    fail "$what: only $found pixels match '$predicate' inside $crop"
+  fi
+}
+
+green='g > 0.9 && r < 0.1 && b < 0.1'
+red='r > 0.9 && g < 0.1 && b < 0.1'
+blue='b > 0.9 && r < 0.1 && g < 0.1'
+magenta='r > 0.9 && b > 0.9 && g < 0.1'
+
+[[ -x $CLIENT ]] || fail "unmap client is not built"
+
+configure window
+
+mkfifo "$UMBRIEL_RUNTIME_DIR/adaptive-bar.fifo"
+FILL_COLOR=0xFFFF0000 TOP_BAND_COLOR=0xFF00FF00 TOP_BAND_HEIGHT=1 REPAINT_ON_STDIN=1 \
+  "$CLIENT" adaptive-bar 480 300 < "$UMBRIEL_RUNTIME_DIR/adaptive-bar.fifo" > "$LOG" 2>&1 &
+exec 3> "$UMBRIEL_RUNTIME_DIR/adaptive-bar.fifo"
+send() { printf '%s' "$1" >&3; }
+
+await_lines "$LOG" mapped 1
+"$UMBRIEL" settle
+grim "$FRAME"
+# The bar takes the window's top edge, not its body, and not the palette's magenta.
+expect "$green" 1000 "a window-coloured bar"
+expect_none "$red" "the bar sampled the window body instead of its top edge"
+expect_none "$magenta" "the palette colour stayed on a window-coloured bar"
+
+# The sample height is live: one row is the green edge, three rows reach into the red body.
+configure window "#00000000" "" "" 3
+"$UMBRIEL" settle
+grim "$FRAME"
+expect_in "$red" "$BAR_FULL" 1000 "a three-row sample reaching into the window body"
+configure window
+"$UMBRIEL" settle
+grim "$FRAME"
+expect_none "$red" "the one-row sample kept to the window's top edge"
+
+# The application repaints the whole window; the bar follows with no reload in between.
+send B
+await_lines "$LOG" repainted 1
+"$UMBRIEL" settle
+grim "$FRAME"
+expect "$blue" 1000 "a bar following a repaint"
+expect_none "$green" "the bar kept the previous window colour"
+
+# The fill is clipped to the frame's rounded corner, like the palette it covers: an unclipped fill squares that corner
+# off and paints the window's colour over the desktop. The window starts at 173,109, so (174,82) is the bar's first
+# pixel and lies outside a 12 px arc. The band is blue at this point, so the fill is blue and the desktop is black.
+configure window "" "" "" 1 12
+"$UMBRIEL" settle
+grim "$FRAME"
+read -r corner_r corner_g corner_b < <(pixel 174 82)
+if (( corner_r < 32 && corner_g < 32 && corner_b > 128 )); then
+  fail "the window-coloured fill squared off the rounded corner: $corner_r $corner_g $corner_b"
+fi
+configure window
+"$UMBRIEL" settle
+grim "$FRAME"
+expect "$blue" 1000 "the window-coloured bar after the radius returns to zero"
+
+# The palette colour is still the fixed choice, and the switch works live.
+configure fixed
+"$UMBRIEL" settle
+grim "$FRAME"
+expect "$magenta" 1000 "the palette colour after switching back to fixed"
+expect_none "$red" "the window colour survived color_source = \"fixed\""
+
+# The close animation draws the title above the fill: a snapshot that stacks the fill over it shows a flat smear.
+window_id=$("$UMBRIEL" windows --json | jq -r '.[] | select(.title == "adaptive-bar") | .id')
+[[ -n $window_id && $window_id != null ]] || fail "the adaptive-bar window is gone before the close animation"
+configure window "#FFFFFFFF" closing buttons
+"$UMBRIEL" settle
+grim "$FRAME"
+expect_in 'r > 0.9 && g > 0.9 && b > 0.9' "$BAR_FULL" 40 "the title over the window-coloured fill"
+"$UMBRIEL" clock-freeze > /dev/null
+"$UMBRIEL" msg window-close "$window_id" > /dev/null
+"$UMBRIEL" clock-advance 250 > /dev/null
+grim "$FRAME"
+expect_in 'r > 0.6 && g > 0.6 && b > 0.6' "$BAR_FULL" 40 "the title in the bar's close animation"
+# The fill sits under the buttons in the live bar, so the snapshot has to keep that order: buttons over fill, and the
+# fill itself present rather than faded to the palette.
+expect_in 'b > 0.6 && b < 0.9 && r < 0.15 && g < 0.15' "$BAR_FULL" 1000 \
+  "the window-coloured fill in the bar's close animation"
+expect_in 'r > 0.6 && g < 0.15 && b < 0.15' "$BAR_FULL" 40 "the button backgrounds in the bar's close animation"
+"$UMBRIEL" clock-advance 1000 > /dev/null
+"$UMBRIEL" settle
+
+# The average takes one colour from the whole edge: a band that is green on one side and blue on the other must show the
+# same blend at both ends of the bar. The smear shows the sides. This is what tells the two modes apart, and it is what
+# keeps a tab row or a loading bar on that edge out of the colour.
+readonly LOG2="$UMBRIEL_RUNTIME_DIR/adaptive-average.log"
+configure average
+# A fresh pipe: the first client's write end is closed with it.
+mkfifo "$UMBRIEL_RUNTIME_DIR/adaptive-average.fifo"
+FILL_COLOR=0xFFFF0000 TOP_BAND_COLOR=0xFF00FF00 TOP_BAND_SPLIT=0xFF0000FF TOP_BAND_HEIGHT=2 REPAINT_ON_STDIN=1 \
+  "$CLIENT" adaptive-bar 480 300 < "$UMBRIEL_RUNTIME_DIR/adaptive-average.fifo" > "$LOG2" 2>&1 &
+exec 4> "$UMBRIEL_RUNTIME_DIR/adaptive-average.fifo"
+await_lines "$LOG2" mapped 1
+"$UMBRIEL" settle
+grim "$FRAME"
+read -r left_r left_g left_b < <(pixel 200 84)
+read -r right_r right_g right_b < <(pixel 620 84)
+near() { (( $1 >= $2 - 12 && $1 <= $2 + 12 )); }
+if ! near "$left_g" "$right_g" || ! near "$left_b" "$right_b" || ! near "$left_r" "$right_r"; then
+  fail "an averaged bar was not uniform: left $left_r $left_g $left_b, right $right_r $right_g $right_b"
+fi
+# The readback covers the edge behind the title, not the whole bar, so a split edge yields the leading half rather
+# than a blend of both. Reading the whole width would blend them and drop the green.
+if ! (( left_g > 200 && left_b < 40 && left_r < 40 )); then
+  fail "an averaged bar did not take the edge behind the title: $left_r $left_g $left_b"
+fi
+# The width the compositor logs is that cap: a whole-edge read would log the bar's full 480 px.
+sample_width=$(rg -o 'averaged a [0-9]+x[0-9]+ strip' "$UMBRIEL_RUNTIME_DIR/compositor.log" | tail -1 \
+  | sed -E 's/.*averaged a ([0-9]+)x[0-9]+ strip/\1/')
+[[ -n $sample_width ]] || fail "no strip readback was logged"
+if ! (( sample_width > 0 && sample_width < 400 )); then
+  fail "the strip readback covered ${sample_width}px of the 480px edge instead of the title"
+fi
+
+# The same window in smear mode keeps the two sides distinct.
+configure window
+"$UMBRIEL" settle
+grim "$FRAME"
+read -r left_r left_g left_b < <(pixel 200 84)
+read -r right_r right_g right_b < <(pixel 620 84)
+if ! (( left_g > 200 && left_b < 40 && right_b > 200 && right_g < 40 )); then
+  fail "a smeared bar did not keep the window edge: left $left_r $left_g $left_b, right $right_r $right_g $right_b"
+fi
+
+# Repaint while the bar is smearing, so the mean cached before this point is out of date.
+printf 'B' >&4
+await_lines "$LOG2" repainted 1
+"$UMBRIEL" settle
+
+# Switching to average is live on its own: an idle window must not wait for its next commit, and the mean must be the
+# edge as it is now, not the one the bar last averaged.
+configure average
+"$UMBRIEL" settle
+grim "$FRAME"
+read -r left_r left_g left_b < <(pixel 200 84)
+read -r right_r right_g right_b < <(pixel 620 84)
+if ! near "$left_g" "$right_g" || ! (( left_b > 200 && left_g < 40 && left_r < 40 )); then
+  fail "an averaged bar was stale after switching live: left $left_r $left_g $left_b, right $right_r $right_g $right_b"
+fi
+
+# And the mean follows further repaints rather than freezing on the colour it was first baked with.
+printf 'R' >&4
+await_lines "$LOG2" repainted 2
+"$UMBRIEL" settle
+grim "$FRAME"
+read -r left_r left_g left_b < <(pixel 200 84)
+read -r right_r right_g right_b < <(pixel 620 84)
+if ! near "$left_r" "$right_r" || ! near "$left_b" "$right_b" \
+   || ! (( left_r > 200 && left_g < 40 && left_b < 40 )); then
+  fail "an averaged bar did not follow a repaint: left $left_r $left_g $left_b, right $right_r $right_g $right_b"
+fi
+
+# A commit that damages only the body must not read the strip back: the average is a flat colour, so a readback there
+# is pure cost, and it finishes the frame first. The compositor logs each readback, so the count is the observable.
+readbacks() { rg -c 'averaged a [0-9]+x[0-9]+ strip read back' "$UMBRIEL_RUNTIME_DIR/compositor.log" || true; }
+before=$(readbacks)
+# A zero baseline would make the comparison vacuous: the earlier phases must have sampled at least once.
+(( before > 0 )) || fail "no strip readback was logged, so the average never sampled the edge"
+printf 'b' >&4
+await_lines "$LOG2" repainted 3
+"$UMBRIEL" settle
+after=$(readbacks)
+if (( after != before )); then
+  fail "a body-only commit read the strip back: $before -> $after"
+fi
+
+# A transparent edge is a readable edge with no colour in it, so the palette comes back. A buffer that cannot be read
+# at all is the other case: it keeps the last colour the window gave. The two must not share a path.
+printf 't' >&4
+await_lines "$LOG2" repainted 4
+"$UMBRIEL" settle
+grim "$FRAME"
+expect "$magenta" 1000 "the palette colour under a transparent averaged edge"
+expect_none 'g > 0.4 && g < 0.6 && b > 0.4 && b < 0.6' "the averaged colour survived a transparent edge"
+
+# The mean has to outlive the scene's upload, which drops the scene's own lock once a texture exists: a bar that does
+# not hold its own would snapshot nothing and fade the palette instead of the mean. The repaint also proves the mean
+# comes back after a transparent edge dropped it.
+printf 'B' >&4
+await_lines "$LOG2" repainted 5
+"$UMBRIEL" settle
+window_id=$("$UMBRIEL" windows --json | jq -r '.[] | select(.title == "adaptive-bar") | .id')
+[[ -n $window_id && $window_id != null ]] || fail "the adaptive-bar window is gone before the average close animation"
+configure average "#00000000" closing
+"$UMBRIEL" settle
+"$UMBRIEL" clock-freeze > /dev/null
+"$UMBRIEL" msg window-close "$window_id" > /dev/null
+"$UMBRIEL" clock-advance 250 > /dev/null
+grim "$FRAME"
+# A quarter of a 1000 ms linear fade: the blue mean at 0.75, not the palette's magenta at 0.75.
+expect_in 'b > 0.6 && b < 0.9 && r < 0.15 && g < 0.15' "$BAR" 1000 "the mean in the average bar's close animation"
+expect_none_in 'r > 0.6 && b > 0.6' "$BAR" "the palette replaced the mean in the close animation"
+"$UMBRIEL" clock-advance 1000 > /dev/null
+"$UMBRIEL" settle
diff --git a/tests/harness/checks/render/title_bar_contrast.sh b/tests/harness/checks/render/title_bar_contrast.sh
new file mode 100755
index 00000000..da866e0e
--- /dev/null
+++ b/tests/harness/checks/render/title_bar_contrast.sh
@@ -0,0 +1,261 @@
+#!/usr/bin/env bash
+# harness: outputs=1
+# A title whose color would vanish into the bar reverses to black or white, the dark edge behind it and around its
+# symbols is on in every color_source and one key turns it off, and `color_source = "window"` only reverses — and only
+# reads the edge back — when it is allowed to sample.
+set -euo pipefail
+source "$(dirname "$UMBRIEL_HARNESS_LIB")/title_bar.sh"
+
+readonly CLIENT="${UMBRIEL_UNMAP_CLIENT:-./build-debug/tests/unmap-client}"
+readonly LOG="$UMBRIEL_RUNTIME_DIR/title-bar-contrast.log"
+readonly FRAME="$UMBRIEL_RUNTIME_DIR/title-bar-contrast.png"
+# The floating window is 480x300 at 173,109, so its 28 px bar covers 173..653 by 81..109, inset by a pixel here. The
+# button row sits at the bar's right edge, where a short title never reaches.
+readonly BAR="474x26+175+82"
+readonly BUTTONS="90x26+555+82"
+
+fail() {
+  echo "$1"
+  exit 1
+}
+
+# $1 color_source, $2 bar color, $3 title color, $4 extra [appearance.title_bar] lines, $5 extra [colors.title_bar],
+# $6 button glyph visibility, $7 painted button backgrounds.
+configure() {
+  local source=$1 background=$2 text=$3 title_bar=${4:-} colors=${5:-} glyph=${6:-never} backgrounds=${7:-false}
+  cat > "$UMBRIEL_CONFIG" <<EOF
+[general]
+xwayland = false
+show_cheatsheet = false
+autostart = []
+
+[output.HEADLESS-1]
+scale = 1.0
+
+[animation]
+enabled = false
+
+[appearance]
+border_width = 0
+outer_border_width = 0
+corner_radius = 0
+
+[appearance.shadow]
+enabled = false
+
+[appearance.blur]
+enabled = false
+
+[appearance.title_bar]
+mode = "forced"
+height = 28
+color_source = "$source"
+button_position = "right"
+button_glyph = "$glyph"
+button_background = $backgrounds
+$title_bar
+
+[colors.title_bar]
+background = "$background"
+background_unfocused = "$background"
+text = "$text"
+text_unfocused = "$text"
+$colors
+
+[[window_rule]]
+match.title = "^contrast-bar\$"
+default_floating = true
+default_floating_size_px = { width = 480, height = 300 }
+default_position = { x = 173, y = 109, anchor = "top_left" }
+EOF
+  "$UMBRIEL" msg config-reload > /dev/null
+}
+
+# The same bar with visible symbols drawn on the bar itself (button_background is off) and the title in the bar's own
+# color, so only the symbols and their edges paint anything.
+configure_buttons() {
+  configure fixed "$1" "$1" "$3" "close_glyph = \"$2\"
+maximize_glyph = \"$2\"
+minimize_glyph = \"$2\"" always
+}
+
+count() { "$UMBRIEL_PIXEL_PROBE" "$FRAME" count "$1" "${2:-$BAR}"; }
+
+expect_at_least() {
+  local predicate=$1 minimum=$2 what=$3 region=${4:-$BAR} found
+  found=$(count "$predicate" "$region")
+  ((found >= minimum)) || fail "$what: only $found pixels match '$predicate'"
+}
+
+expect_none() {
+  local predicate=$1 what=$2 region=${3:-$BAR} found
+  found=$(count "$predicate" "$region")
+  ((found == 0)) || fail "$what: $found pixels still match '$predicate'"
+}
+
+# A reversal paints pure white, which the palette's light grey (#E8E8E8) cannot reach. Counting it is how a flip is told
+# apart from a configured color that merely reads well on its own.
+readonly white='r > 0.98 && g > 0.98 && b > 0.98'
+readonly light='r > 0.85 && r < 0.96 && g > 0.85 && g < 0.96 && b > 0.85 && b < 0.96'
+readonly dark='r < 0.5 && g < 0.5 && b < 0.5'
+# A reversal onto a light bar paints pure black, which no color configured here reaches.
+readonly black='r < 0.02 && g < 0.02 && b < 0.02'
+# Anything that is not the bar's own white: an edge thinner than a glyph stroke only ever lands between the two.
+readonly notwhite='r < 0.98 || g < 0.98 || b < 0.98'
+# A reversed symbol, loosely: a stroke thinner than a pixel never reaches pure black, while the unreversed grey is 0.45.
+readonly reversed='r < 0.2 && g < 0.2 && b < 0.2'
+
+[[ -x $CLIENT ]] || fail "unmap client is not built"
+
+# The window rule places the bar, so it has to be in place before the client maps: a reload does not re-place a mapped
+# window. The top edge is light, so the dark edge under the title has something to show against.
+configure fixed '#101010FF' '#181818FF'
+mkfifo "$UMBRIEL_RUNTIME_DIR/title-bar-contrast.fifo"
+FILL_COLOR=0xFFFF0000 TOP_BAND_COLOR=0xFFF0F0F0 TOP_BAND_HEIGHT=1 REPAINT_ON_STDIN=1 \
+  "$CLIENT" contrast-bar 480 300 < "$UMBRIEL_RUNTIME_DIR/title-bar-contrast.fifo" > "$LOG" 2>&1 &
+exec 3> "$UMBRIEL_RUNTIME_DIR/title-bar-contrast.fifo"
+shot() {
+  "$UMBRIEL" settle
+  grim -o HEADLESS-1 "$FRAME"
+}
+await_lines "$LOG" mapped 1
+
+# A dark title on a dark bar reverses to white.
+configure fixed '#101010FF' '#181818FF'
+shot
+expect_at_least "$white" 10 "a title that reverses on a dark bar"
+
+# The same pair with the reversal off keeps the configured color, so nothing bright is drawn.
+configure fixed '#101010FF' '#181818FF' 'title_contrast = false'
+shot
+expect_none "$white" "title_contrast = false still reversed the title"
+
+# A pair that already reads is left alone: the configured grey is drawn rather than black or white.
+configure fixed '#101010FF' '#E8E8E8FF'
+shot
+expect_at_least "$light" 10 "a title whose color already reads"
+expect_none "$white" "a readable title was reversed anyway"
+
+# The dark edge follows its own key, not the color source. A white title on a white bar is invisible, so every dark
+# pixel in the bar is the edge itself.
+configure fixed '#FFFFFFFF' '#FFFFFFFF' 'title_contrast = false'
+shot
+expect_at_least "$dark" 10 "the title's dark edge on a fixed bar"
+configure fixed '#FFFFFFFF' '#FFFFFFFF' 'title_contrast = false
+title_shadow = false'
+shot
+expect_none "$dark" "title_shadow = false still shaded the title"
+
+# The same edge on an adaptive bar, and the same key turns it off there. The palette is dark, so only the mirrored band
+# can hide the white title.
+configure window '#101010FF' '#FFFFFFFF' 'title_contrast = false'
+shot
+expect_at_least "$dark" 10 "the title's dark edge on a window-colored bar"
+configure window '#FFFFFFFF' '#FFFFFFFF' 'title_contrast = false
+title_shadow = false'
+shot
+expect_none "$dark" "title_shadow = false still shaded a window-colored title"
+
+# A window-colored bar has no color to judge the title against, and the palette is not what shows, so it does not
+# reverse until it is allowed to sample. The palette is dark and the edge light here, so only a sample of the edge can
+# flip the title — a decision taken on the palette would leave it light grey.
+# A readback is invisible in a screenshot, so its count is read from the compositor's own line for it, as the adaptive
+# check does. The match stops at the verb so a rewording does not break the check.
+readbacks() {
+  local found
+  found=$(rg -c 'strip read back' "$UMBRIEL_RUNTIME_DIR/compositor.log" || true)
+  echo "${found:-0}"
+}
+configure window '#101010FF' '#E8E8E8FF' 'title_shadow = false'
+shot
+expect_none "$dark" "a window-colored title reversed without the sample"
+(( $(readbacks) == 0 )) || fail "title_contrast_sample = false still read the edge back"
+configure window '#101010FF' '#E8E8E8FF' 'title_shadow = false
+title_contrast_sample = true'
+shot
+expect_at_least "$dark" 10 "a title reversing on a sampled window-colored bar"
+(( $(readbacks) > 0 )) || fail "title_contrast_sample = true did not read the edge back"
+
+# Turning the sample off again drops the color it gave: the bar is back to being unknown, so the title stands as
+# configured rather than reversing against an edge nobody reads any more.
+configure window '#101010FF' '#E8E8E8FF' 'title_shadow = false
+title_contrast_sample = false'
+shot
+expect_none "$dark" "a kept sample kept reversing the title after the key was turned off"
+
+# "average" knows the bar's color without a key, so the same reversal happens there against the mean.
+configure average '#101010FF' '#E8E8E8FF' 'title_shadow = false'
+shot
+expect_at_least "$dark" 10 "a title reversing against an averaged bar"
+configure average '#101010FF' '#E8E8E8FF' 'title_shadow = false
+title_contrast = false'
+shot
+expect_none "$dark" "title_contrast = false still reversed an averaged title"
+
+# A symbol can flip while the title does not: the fill moved, the title's own decision did not. Nothing but the commit
+# hook can notice that, since the symbols are painted by a repaint rather than by the mirror. The title is chosen to read
+# on both edges; the symbols reverse only on the green one, which a repaint reaches without touching the title color.
+configure window '#101010FF' '#505050FF' 'title_shadow = false
+title_contrast_sample = true' 'close_glyph = "#737373FF"
+maximize_glyph = "#737373FF"
+minimize_glyph = "#737373FF"' always
+shot
+expect_none "$reversed" "a symbol reversed on an edge it reads against" "$BUTTONS"
+printf 'G' >&3
+await_lines "$LOG" repainted 1
+shot
+expect_at_least "$reversed" 3 "a symbol left behind after the edge changed under it" "$BUTTONS"
+
+# An edge with nothing in it leaves the palette showing, so that is what the title is judged against — and it is read
+# live, not remembered from the moment of the sample: the same window under a dark palette reverses, under a light one
+# it stays as configured.
+configure window '#E8E8E8FF' '#202020FF' 'title_shadow = false
+title_contrast_sample = true'
+printf 't' >&3
+await_lines "$LOG" repainted 2
+shot
+expect_none "$white" "a title judged against a light palette reversed anyway"
+configure window '#000000FF' '#202020FF' 'title_shadow = false
+title_contrast_sample = true'
+shot
+expect_at_least "$white" 10 "a title still judged against the palette of the previous sample"
+
+# The reversal reaches the symbols drawn straight on the bar, because they sit on that color too. Only the button row is
+# counted, so the title's own reversal cannot stand in for a symbol's.
+configure_buttons '#FFFFFFFF' '#B0B0B0FF' 'title_shadow = false'
+shot
+expect_at_least "$dark" 5 "a symbol reversing against the bar it sits on" "$BUTTONS"
+configure_buttons '#FFFFFFFF' '#B0B0B0FF' 'title_shadow = false
+title_contrast = false'
+shot
+expect_none "$dark" "title_contrast = false still reversed a symbol" "$BUTTONS"
+
+# A symbol on a painted button color is judged against that color rather than the bar: the bar is white here, which the
+# symbols read against, while their button colors are close enough to them to reverse.
+configure_backgrounds() {
+  configure fixed '#101010FF' '#101010FF' "$3" "close = \"$1\"
+maximize = \"$1\"
+minimize = \"$1\"
+close_glyph = \"$2\"
+maximize_glyph = \"$2\"
+minimize_glyph = \"$2\"" always true
+}
+configure_backgrounds '#FFFFFFFF' '#EFEFEFFF' 'title_shadow = false'
+shot
+expect_at_least "$black" 5 "a symbol reversing against its own button color" "$BUTTONS"
+configure_backgrounds '#FFFFFFFF' '#EFEFEFFF' 'title_shadow = false
+title_contrast = false'
+shot
+expect_none "$black" "title_contrast = false still reversed a symbol on its button color" "$BUTTONS"
+
+# The edge follows title_shadow around the symbols as well: a white symbol on a white bar paints nothing, so every pixel
+# that is not white in the button row is the edge itself.
+configure_buttons '#FFFFFFFF' '#FFFFFFFF' 'title_contrast = false'
+shot
+expect_at_least "$notwhite" 5 "the symbols' dark edge" "$BUTTONS"
+configure_buttons '#FFFFFFFF' '#FFFFFFFF' 'title_contrast = false
+title_shadow = false'
+shot
+expect_none "$notwhite" "title_shadow = false still shaded the symbols" "$BUTTONS"
+
+echo "the edge follows title_shadow on the title and the symbols, the title and symbols reverse only when their color would vanish, and window mode reads the edge back only when asked"
diff --git a/tests/harness/checks/render/title_bar_icons.sh b/tests/harness/checks/render/title_bar_icons.sh
index ca944dd4..c542a436 100755
