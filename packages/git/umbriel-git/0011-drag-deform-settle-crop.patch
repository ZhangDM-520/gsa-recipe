diff --git a/tests/harness/checks/drag/physics_release_settle.sh b/tests/harness/checks/drag/physics_release_settle.sh
new file mode 100644
index 00000000..4c3bf4a5
--- /dev/null
+++ b/tests/harness/checks/drag/physics_release_settle.sh
@@ -0,0 +1,191 @@
+#!/usr/bin/env bash
+# harness: outputs=2
+# Window physics displaces a dragged sheet across the shared output edge (each
+# output draws its half). The deform keeps running after release, so the sheet
+# still hangs over the boundary — its far half must keep drawing on the
+# neighbour until the deform settles, or the window's own ring is cut off at
+# the boundary the moment the move ends. Pinned twice: a drop on the home
+# output, and a drop on the neighbour output whose release TRANSFERS workspace
+# (the transfer's park + re-home are the release's resting re-homes too).
+set -euo pipefail
+source "$UMBRIEL_HARNESS_LIB"
+
+readonly BTN_LEFT=272
+hnheld=0; hn16=0; hn64=0; gr16=0; gr64=0; hn320=0; hnsettled=0
+bheld=0; b16=0; b64=0; bg16=0; bg64=0; bsettled=0
+
+cat >> "$UMBRIEL_CONFIG" <<'EOF'
+
+[layout]
+mode = "floating"
+
+[colors]
+backdrop = "#000000FF"
+[colors.border]
+focused = "#FF0000FF"
+[appearance]
+border_width = 8
+outer_border_width = 0
+corner_radius = 0
+drag_opacity = 1.0
+[appearance.shadow]
+enabled = false
+[animation]
+duration_ms = 1
+[animation.windows_in]
+enabled = false
+[animation.windows_out]
+enabled = false
+[animation.windows_drag]
+physics = true
+[[window_rule]]
+match.title = "^ring-cut$"
+default_floating = true
+default_floating_size_px = { width = 400, height = 300 }
+[effects]
+border = "ring"
+window = "window"
+[effects.preset.ring]
+kind = "border"
+shader = "ring.glsl"
+padding = 4
+[effects.preset.window]
+kind = "window"
+shader = "window.glsl"
+EOF
+cat > "$UMBRIEL_RUNTIME_DIR/ring.glsl" <<'GLSL'
+vec4 border(vec2 uv) { return vec4(1.0, 0.0, 0.0, 1.0); }
+GLSL
+cat > "$UMBRIEL_RUNTIME_DIR/window.glsl" <<'GLSL'
+vec4 window(vec2 uv) { return umbriel_sample(uv); }
+GLSL
+"$UMBRIEL" msg config-reload > /dev/null
+
+FILL_COLOR=0xFF00FF00 "$UMBRIEL_UNMAP_CLIENT" ring-cut 400 300 > "$UMBRIEL_RUNTIME_DIR/ring-cut.log" 2>&1 &
+await_window ring-cut
+"$UMBRIEL" settle > /dev/null
+
+home=$(window_by_title ring-cut | jq -r '.workspace' | cut -d: -f1)
+if [[ $home == HEADLESS-1 ]]; then neighbour=HEADLESS-2; else neighbour=HEADLESS-1; fi
+read -r wx wy ww wh < <(window_by_title ring-cut | jq -r '"\(.x) \(.y) \(.w) \(.h)"')
+# Park the window straddling the shared edge: 200px on each side of x=1280.
+gx=$((wx + 40))
+gy=$((wy + 40))
+dx=$((1080 - wx))
+pointer_hold 2560 720 move "$gx" "$gy" mod super press "$BTN_LEFT" \
+  move $((gx + dx / 3)) "$gy" \
+  move $((gx + 2 * dx / 3)) "$gy" \
+  move $((gx + dx)) "$gy" -- release "$BTN_LEFT" mod none
+
+stats() { # $1 = label: red/green counts near the shared edge on both outputs
+  grim -o "$home" "$UMBRIEL_RUNTIME_DIR/$1-home.png"
+  grim -o "$neighbour" "$UMBRIEL_RUNTIME_DIR/$1-neighbour.png"
+  local hr hn gr gn
+  hr=$("$UMBRIEL_PIXEL_PROBE" "$UMBRIEL_RUNTIME_DIR/$1-home.png" count 'r > 0.8 && g < 0.2 && b < 0.2' "120x720+1160+0")
+  hn=$("$UMBRIEL_PIXEL_PROBE" "$UMBRIEL_RUNTIME_DIR/$1-neighbour.png" count 'r > 0.8 && g < 0.2 && b < 0.2' "120x720+0+0")
+  gr=$("$UMBRIEL_PIXEL_PROBE" "$UMBRIEL_RUNTIME_DIR/$1-home.png" count 'g > 0.8 && r < 0.2 && b < 0.2' "120x720+1160+0")
+  gn=$("$UMBRIEL_PIXEL_PROBE" "$UMBRIEL_RUNTIME_DIR/$1-neighbour.png" count 'g > 0.8 && r < 0.2 && b < 0.2' "120x720+0+0")
+  echo "$1 home-edge red=$hr green=$gr | neighbour-edge red=$hn green=$gn"
+  case $1 in
+    held) hnheld=$hn ;;
+    r16) hn16=$hn; gr16=$gr ;;
+    r64) hn64=$hn; gr64=$gr ;;
+    r320) hn320=$hn ;;
+    settled) hnsettled=$hn ;;
+    bheld) bheld=$hr ;;
+    b16) b16=$hr; bg16=$gn ;;
+    b64) b64=$hr; bg64=$gn ;;
+    bsettled) bsettled=$hr ;;
+  esac
+}
+
+"$UMBRIEL" clock-freeze
+"$UMBRIEL" clock-advance 16 > /dev/null
+stats held
+pointer_release
+"$UMBRIEL" clock-advance 16 > /dev/null
+stats r16
+"$UMBRIEL" clock-advance 48 > /dev/null
+stats r64
+"$UMBRIEL" clock-advance 256 > /dev/null
+stats r320
+"$UMBRIEL" clock-advance 768 > /dev/null
+stats settled
+"$UMBRIEL" clock-resume
+
+# The scenario must have engaged: while held, the ring's far half draws on the
+# neighbour, and the sheet is still measurable at r16. Without these floors the
+# assertions below pass vacuously.
+if ((hnheld < 100)); then
+  echo "scenario never engaged: no ring on the neighbour while held ($hnheld)"
+  exit 1
+fi
+if ((gr16 < 10000)) || ((gr64 < 10000)); then
+  echo "unmeasurable: home samples too small (gr16=$gr16 gr64=$gr64), a cut would pass silently"
+  exit 1
+fi
+
+# While the released sheet is still displaced across the shared edge (its home
+# half still drawn), the neighbour must keep drawing the far half. Re-homing the
+# view under the home output's clipped root the moment the move ends cuts the
+# deformed sheet's ring off at the boundary. Pinned at both displaced samples:
+# a re-home anywhere before the settle must fail here.
+if ((gr16 > 10000)) && ((hn16 < 100)); then
+  echo "the release cut the deformed sheet at the shared edge (neighbour red: held=$hnheld r16=$hn16 r64=$hn64)"
+  exit 1
+fi
+if ((gr64 > 10000)) && ((hn64 < 100)); then
+  echo "the release cut the deformed sheet mid-settle (neighbour red: r64=$hn64)"
+  exit 1
+fi
+
+# And the home clip must come back once the deform settled: a view left under
+# the unclipped drag tree forever would keep drawing past the edge.
+if ((hnsettled >= 100)); then
+  echo "the home clip never applied after settle (neighbour red: r320=$hn320 settled=$hnsettled)"
+  exit 1
+fi
+echo "a released sheet keeps drawing across the shared edge until the deform settles"
+
+# Second release — the drop lands on the NEIGHBOUR output, so it TRANSFERS
+# workspace: removeView parks the view under the server tree and addView
+# re-homes it onto the destination layer. Both are the release's resting
+# re-home and must wait for the settle just the same; a transfer that lands
+# immediately cuts the trailing sheet on the home side of the edge.
+pointer_hold 2560 720 move 1120 "$gy" mod super press "$BTN_LEFT" \
+  move 1180 "$gy" \
+  move 1250 "$gy" \
+  move 1320 "$gy" -- release "$BTN_LEFT" mod none
+"$UMBRIEL" clock-freeze
+"$UMBRIEL" clock-advance 16 > /dev/null
+stats bheld
+pointer_release
+"$UMBRIEL" clock-advance 16 > /dev/null
+stats b16
+"$UMBRIEL" clock-advance 48 > /dev/null
+stats b64
+"$UMBRIEL" clock-advance 1024 > /dev/null
+stats bsettled
+"$UMBRIEL" clock-resume
+
+if ((bheld < 100)); then
+  echo "transfer scenario never engaged: no ring on the home side while held ($bheld)"
+  exit 1
+fi
+if ((bg16 < 10000)) || ((bg64 < 10000)); then
+  echo "unmeasurable: transfer displacement samples too small (bg16=$bg16 bg64=$bg64)"
+  exit 1
+fi
+if ((bg16 > 10000)) && ((b16 < 100)); then
+  echo "the transfer cut the deformed sheet at the shared edge (home red: held=$bheld r16=$b16 r64=$b64)"
+  exit 1
+fi
+if ((bg64 > 10000)) && ((b64 < 100)); then
+  echo "the transfer cut the deformed sheet mid-settle (home red: r64=$b64)"
+  exit 1
+fi
+if ((bsettled >= 100)); then
+  echo "the destination clip never applied after the transfer settle (home red: $bsettled)"
+  exit 1
+fi
+echo "a transferred sheet keeps drawing across the shared edge until the deform settles"
diff --git a/tests/harness/checks/drag/settle_dialog_switch.sh b/tests/harness/checks/drag/settle_dialog_switch.sh
new file mode 100755
index 00000000..ec4481ec
--- /dev/null
+++ b/tests/harness/checks/drag/settle_dialog_switch.sh
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+# harness: outputs=1
+# A dragged window carries its transient dialog into the drag tree. A workspace
+# switch must not disable a dialog the drag elevated with its parent: the
+# workspace's own visibility pass would hide it, and the drag tree — not the
+# workspace — owns it for as long as the grab lasts.
+#
+# The dialog is left unattached (`attach_to_parent = false`) so it keeps its own
+# scene node: an attached one would ride the parent's node and hide the bug.
+set -euo pipefail
+source "$UMBRIEL_REPO/tests/harness/drag_settle_lib.sh"
+
+readonly PARENT=settle-parent
+readonly DIALOG=settle-child
+readonly SPAN="${SETTLE_OUTPUT_W}x${SETTLE_OUTPUT_H}"
+
+settle_config
+cat >> "$UMBRIEL_CONFIG" <<'EOF'
+
+[output.HEADLESS-1]
+position = [0, 0]
+workspaces = ["ONE", "TWO"]
+
+[[window_rule]]
+match.title = "^settle-child$"
+default_floating = true
+attach_to_parent = false
+EOF
+"$UMBRIEL" msg config-reload > /dev/null
+
+settle_map_dialog "$PARENT" "$DIALOG"
+settle_drag_corner "$PARENT" "$SPAN" hold
+"$UMBRIEL" clock-freeze
+"$UMBRIEL" clock-advance 16 > /dev/null
+held=$(settle_red)
+"$UMBRIEL" msg workspace-switch TWO > /dev/null
+"$UMBRIEL" clock-advance 450 > /dev/null
+across=$(settle_red)
+"$UMBRIEL" clock-resume
+pointer_release
+"$UMBRIEL" settle > /dev/null
+
+if ((held < SETTLE_DIALOG_FLOOR)); then
+  echo "scenario never engaged: the dialog does not draw with its parent's drag (red=$held)"
+  exit 1
+fi
+if ((across < SETTLE_DIALOG_FLOOR)); then
+  echo "the drag's child dialog was hidden with the workspace (red=$held -> $across)"
+  exit 1
+fi
+echo "a dragged window's dialog rides along across a workspace switch"
diff --git a/tests/harness/checks/drag/settle_held_workspace_switch.sh b/tests/harness/checks/drag/settle_held_workspace_switch.sh
new file mode 100755
index 00000000..b61f243f
--- /dev/null
+++ b/tests/harness/checks/drag/settle_held_workspace_switch.sh
@@ -0,0 +1,69 @@
+#!/usr/bin/env bash
+# harness: outputs=1
+# A window the drag presents is the drag's payload: switching workspace must not
+# steal it. The drag tree owns the window's visibility while it is held, so the
+# workspace that goes away must neither hide it nor take it along — and the drop
+# must land it on the workspace the user can see.
+#
+# This is the counterpart of settle_workspace_switch: there the sheet is released
+# and must travel with its workspace, here it is held and must not.
+set -euo pipefail
+source "$UMBRIEL_REPO/tests/harness/drag_settle_lib.sh"
+
+readonly TITLE=stuck-sheet
+readonly SPAN="${SETTLE_OUTPUT_W}x${SETTLE_OUTPUT_H}"
+
+settle_config
+settle_sheet_rule "$TITLE"
+# Static workspaces: a dynamic inventory would prune the emptied workspace and
+# move the window instead of leaving it where the check put it.
+cat >> "$UMBRIEL_CONFIG" <<'EOF'
+
+[output.HEADLESS-1]
+position = [0, 0]
+workspaces = ["ONE", "TWO"]
+EOF
+"$UMBRIEL" msg config-reload > /dev/null
+
+settle_map "$TITLE" 400 300 0xFF00FF00
+settle_sheet_extent "$TITLE"
+
+settle_drag_hold "$TITLE" "$SPAN"
+"$UMBRIEL" clock-freeze
+"$UMBRIEL" clock-advance 16 > /dev/null
+held=$(settle_green)
+"$UMBRIEL" msg workspace-switch TWO > /dev/null
+"$UMBRIEL" clock-advance 450 > /dev/null
+across=$(settle_green)
+"$UMBRIEL" clock-resume
+pointer_release
+"$UMBRIEL" settle > /dev/null
+posed=$(settle_green)
+dropped=$(settle_workspace_name "$(settle_workspace "$TITLE")")
+
+if ((held < SETTLE_FLOOR)); then
+  echo "scenario never engaged: the held window does not draw before the switch (green=$held)"
+  exit 1
+fi
+if ((across < SETTLE_FLOOR)); then
+  echo "the held window vanished with the workspace it was dragged from (green=$held -> $across)"
+  exit 1
+fi
+if ((posed < SETTLE_FLOOR)); then
+  echo "the dropped window is not presented on its own workspace (green=$posed)"
+  exit 1
+fi
+if [[ $dropped != TWO ]]; then
+  echo "the drop did not land the window on the visible workspace: '$dropped', want TWO"
+  exit 1
+fi
+
+# And it belongs to that workspace now: leaving must take it off screen.
+"$UMBRIEL" msg workspace-switch ONE > /dev/null
+"$UMBRIEL" settle > /dev/null
+left_behind=$(settle_green)
+if ((left_behind >= SETTLE_FLOOR)); then
+  echo "the dropped window stayed on screen after its workspace left (green=$left_behind)"
+  exit 1
+fi
+echo "a held window stays with the cursor across a switch and lands on the visible workspace"
diff --git a/tests/harness/checks/drag/settle_overlap_drag.sh b/tests/harness/checks/drag/settle_overlap_drag.sh
new file mode 100644
index 00000000..34877360
--- /dev/null
+++ b/tests/harness/checks/drag/settle_overlap_drag.sh
@@ -0,0 +1,118 @@
+#!/usr/bin/env bash
+# A released window's deferred re-home must not demote the drag tree while
+# another drag is in progress. The shared drag tree is elevated over
+# fullscreen once per drag; if the settling window's departure lowers it, the
+# still-held window drops behind the fullscreen window until its own release.
+# The animation clock freezes before the release, so the settling window cannot
+# fall out of the overlap window by wall-clock luck.
+set -euo pipefail
+source "$UMBRIEL_HARNESS_LIB"
+
+readonly BTN_LEFT=272
+readonly OUTPUT_W=1280
+readonly OUTPUT_H=720
+# dragme's grab point (its center) tracks the pointer; sample well inside it.
+readonly SAMPLE="80x80+600+320"
+readonly FLOOR=2000
+readonly IMAGE="$UMBRIEL_RUNTIME_DIR/settle-overlap.png"
+
+cat >> "$UMBRIEL_CONFIG" <<'EOF'
+
+[layout]
+mode = "floating"
+
+[input.focus]
+follows_mouse = false
+
+[colors]
+backdrop = "#000000FF"
+[appearance]
+border_width = 0
+outer_border_width = 0
+corner_radius = 0
+drag_opacity = 1.0
+[appearance.shadow]
+enabled = false
+[animation]
+duration_ms = 1
+[animation.windows_in]
+enabled = false
+[animation.windows_out]
+enabled = false
+[animation.windows_drag]
+physics = true
+[[window_rule]]
+match.title = "^fullscreen-main$"
+default_floating = false
+default_fullscreen = true
+[[window_rule]]
+match.title = "^settler$"
+default_floating = true
+default_position = { x = 100, y = 200, anchor = "top_left" }
+[[window_rule]]
+match.title = "^dragme$"
+default_floating = true
+default_focused = true
+default_position = { x = 800, y = 120, anchor = "top_left" }
+EOF
+"$UMBRIEL" msg config-reload > /dev/null
+
+map_window() {
+  local title=$1 w=$2 h=$3 color=$4
+  FILL_COLOR=$color "$UMBRIEL_UNMAP_CLIENT" "$title" "$w" "$h" \
+    > "$UMBRIEL_RUNTIME_DIR/$title.log" 2>&1 &
+  await_window "$title"
+  "$UMBRIEL" settle > /dev/null
+}
+
+map_window fullscreen-main 1280 720 0xFF0000FF
+map_window settler 300 220 0xFFFF0000
+map_window dragme 300 220 0xFF00FF00
+
+green_count() {
+  "$UMBRIEL_PIXEL_PROBE" "$IMAGE" count 'g > 0.9 && r < 0.1 && b < 0.1' "$SAMPLE"
+}
+
+# One pointer session: the first hold stops mid-drag of settler, the second
+# holds dragme over the fullscreen window. The releases run only when this
+# check kicks the client.
+pointer_hold "$OUTPUT_W" "$OUTPUT_H" \
+  move 250 310 mod super press "$BTN_LEFT" \
+  move 310 310 move 370 310 move 430 310 \
+  -- release "$BTN_LEFT" mod none \
+  move 950 230 mod super press "$BTN_LEFT" \
+  move 875 263 move 800 296 move 725 330 move 640 360 \
+  mark bgrab hold \
+  release "$BTN_LEFT" mod none
+
+# Freeze before the release: from here on the only ticks are the ones this
+# check orders, so settler is still settling when dragme's grab lands.
+"$UMBRIEL" clock-freeze
+pointer_step bgrab
+
+"$UMBRIEL" clock-advance 16 > /dev/null
+grim -o HEADLESS-1 "$IMAGE"
+held=$(green_count)
+echo "held drag over fullscreen: green=$held"
+
+# The settling sheet's spring has long settled on these ticks: its deferred
+# re-home lands while dragme is still held in the drag tree.
+"$UMBRIEL" clock-advance 64 > /dev/null
+"$UMBRIEL" clock-advance 256 > /dev/null
+"$UMBRIEL" clock-advance 512 > /dev/null
+"$UMBRIEL" clock-advance 1024 > /dev/null
+grim -o HEADLESS-1 "$IMAGE"
+overlap=$(green_count)
+echo "after the overlapping settle: green=$overlap"
+"$UMBRIEL" clock-resume
+pointer_release
+
+if ((held < FLOOR)); then
+  echo "scenario never engaged: the held window does not draw over fullscreen (green=$held)"
+  exit 1
+fi
+if ((overlap < FLOOR)); then
+  echo "the settling window's re-home demoted the drag tree mid-drag: the held window fell behind fullscreen (held=$held overlap=$overlap)"
+  exit 1
+fi
+echo "a settling re-home leaves an in-progress drag elevated"
diff --git a/tests/harness/checks/drag/settle_pinned_dialog.sh b/tests/harness/checks/drag/settle_pinned_dialog.sh
new file mode 100755
index 00000000..41630a86
--- /dev/null
+++ b/tests/harness/checks/drag/settle_pinned_dialog.sh
@@ -0,0 +1,83 @@
+#!/usr/bin/env bash
+# harness: outputs=1
+# The ride outlives the grab. A pinned release parks its wait on the output's
+# pinned root, so the sheet settles under the drag tree while its dialog rides it,
+# and every flush skips a pinned view: only the ride can keep the dialog shown.
+# Switching workspace during that settle must leave both where they are.
+#
+# The dialog sits on its own workspace and the parent is moved onto it, so the
+# switch under test leaves the dialog's workspace entirely.
+set -euo pipefail
+source "$UMBRIEL_REPO/tests/harness/drag_settle_lib.sh"
+
+readonly PARENT=settle-parent
+readonly DIALOG=settle-child
+readonly SPAN="${SETTLE_OUTPUT_W}x${SETTLE_OUTPUT_H}"
+
+settle_config
+cat >> "$UMBRIEL_CONFIG" <<'EOF'
+
+[output.HEADLESS-1]
+position = [0, 0]
+workspaces = ["ONE", "TWO"]
+
+[[window_rule]]
+match.title = "^settle-child$"
+default_floating = true
+attach_to_parent = false
+EOF
+"$UMBRIEL" msg config-reload > /dev/null
+
+settle_map_dialog "$PARENT" "$DIALOG"
+
+dialog_workspace=$(settle_workspace_name "$(settle_workspace "$DIALOG")")
+"$UMBRIEL" msg window-focus "$(settle_id "$PARENT")" > /dev/null
+"$UMBRIEL" msg window-move-to-workspace "$dialog_workspace" > /dev/null
+"$UMBRIEL" msg workspace-switch "$dialog_workspace" > /dev/null
+"$UMBRIEL" settle > /dev/null
+if [[ $(settle_workspace_name "$(settle_workspace "$PARENT")") != "$dialog_workspace" ]]; then
+  echo "scenario never engaged: the parent did not join the dialog on '$dialog_workspace'"
+  exit 1
+fi
+if [[ $dialog_workspace == ONE ]]; then other_workspace=TWO; else other_workspace=ONE; fi
+
+"$UMBRIEL" msg window-focus "$(settle_id "$PARENT")" > /dev/null
+"$UMBRIEL" msg window-toggle-pinned > /dev/null
+"$UMBRIEL" settle > /dev/null
+if [[ $(window_by_title "$PARENT" | jq -r '.pinned') != true ]]; then
+  echo "scenario never engaged: the parent did not pin"
+  exit 1
+fi
+
+settle_drag_corner "$PARENT" "$SPAN" release
+"$UMBRIEL" clock-freeze
+"$UMBRIEL" clock-advance 16 > /dev/null
+held=$(settle_red)
+pointer_release
+"$UMBRIEL" clock-advance 16 > /dev/null
+settle_require_deforming "pinned settle"
+settling=$(settle_red)
+"$UMBRIEL" msg workspace-switch "$other_workspace" > /dev/null
+"$UMBRIEL" clock-advance 450 > /dev/null
+across=$(settle_red)
+"$UMBRIEL" clock-resume
+"$UMBRIEL" settle > /dev/null
+landed=$(settle_red)
+
+if ((held < SETTLE_DIALOG_FLOOR)); then
+  echo "scenario never engaged: the pinned parent's drag does not carry the dialog (red=$held)"
+  exit 1
+fi
+if ((settling < SETTLE_DIALOG_FLOOR)); then
+  echo "scenario never engaged: the dialog does not draw while the pinned sheet settles (red=$settling)"
+  exit 1
+fi
+if ((across < SETTLE_DIALOG_FLOOR)); then
+  echo "the settling drag's dialog was hidden with the workspace (red=$settling -> $across)"
+  exit 1
+fi
+if ((landed < SETTLE_DIALOG_FLOOR)); then
+  echo "the dialog stayed hidden after the pinned sheet landed (red=$across -> $landed)"
+  exit 1
+fi
+echo "a pinned sheet that settles under the drag tree keeps its dialog shown"
diff --git a/tests/harness/checks/drag/settle_workspace_gesture.sh b/tests/harness/checks/drag/settle_workspace_gesture.sh
new file mode 100755
index 00000000..2ae8eedb
--- /dev/null
+++ b/tests/harness/checks/drag/settle_workspace_gesture.sh
@@ -0,0 +1,93 @@
+#!/usr/bin/env bash
+# harness: outputs=1
+# A gesture moves the base workspace's tree before the outgoing workspace is
+# deactivated, so nothing but an explicit flush can land a released sheet's
+# waiting re-home in time: without it the sheet stays parked under the shared
+# drag tree, outside every workspace layer, and hangs at its old screen position
+# for the whole swipe. A cancelled swipe must come back with it; a committed one
+# must take it off screen.
+#
+# This phase sits in the gesture path because the deactivation that would land
+# the wait on its own only happens at commit.
+set -euo pipefail
+source "$UMBRIEL_REPO/tests/harness/drag_settle_lib.sh"
+
+readonly TITLE=stuck-sheet
+readonly SPAN="${SETTLE_OUTPUT_W}x${SETTLE_OUTPUT_H}"
+
+settle_config
+settle_sheet_rule "$TITLE"
+# Static workspaces: a dynamic inventory would prune the emptied workspace and
+# move the window instead of leaving it where the check put it.
+cat >> "$UMBRIEL_CONFIG" <<'EOF'
+
+[output.HEADLESS-1]
+position = [0, 0]
+workspaces = ["ONE", "TWO"]
+EOF
+"$UMBRIEL" msg config-reload > /dev/null
+
+settle_map "$TITLE" 400 300 0xFF00FF00
+settle_sheet_extent "$TITLE"
+
+settle_drag_queue "$TITLE" "$SPAN"
+"$UMBRIEL" clock-freeze
+"$UMBRIEL" clock-advance 16 > /dev/null
+held=$(settle_green)
+pointer_release
+"$UMBRIEL" clock-advance 16 > /dev/null
+settle_require_deforming "gesture"
+read -r wx wy ww wh < <(settle_box "$TITLE")
+
+# `swipe-test end <ms> 1` cancels the gesture; 0 commits it.
+"$UMBRIEL" swipe-test begin 1000 > /dev/null
+"$UMBRIEL" swipe-test update 1016 -80 -80 > /dev/null
+"$UMBRIEL" clock-advance 16 > /dev/null
+cancelled=$(settle_green)
+read -r cx cy cw ch < <(settle_green_bbox)
+"$UMBRIEL" swipe-test end 1032 1 > /dev/null
+"$UMBRIEL" clock-advance 600 > /dev/null
+cancelled_after=$(settle_green)
+cancelled_workspace=$(settle_active_workspace)
+
+# Carry the step past the halfway point so the next release commits it.
+"$UMBRIEL" swipe-test begin 2000 > /dev/null
+"$UMBRIEL" swipe-test update 2016 -80 -80 > /dev/null
+"$UMBRIEL" clock-advance 16 > /dev/null
+committed=$(settle_green)
+read -r mx my mw mh < <(settle_green_bbox)
+"$UMBRIEL" swipe-test update 2032 -220 -220 > /dev/null
+"$UMBRIEL" swipe-test end 2048 0 > /dev/null
+"$UMBRIEL" clock-advance 800 > /dev/null
+committed_away=$(settle_green)
+committed_workspace=$(settle_active_workspace)
+"$UMBRIEL" clock-resume
+"$UMBRIEL" settle > /dev/null
+
+if ((held < SETTLE_FLOOR)); then
+  echo "scenario never engaged: the deformed sheet does not draw before the swipe (green=$held)"
+  exit 1
+fi
+if ((cancelled < SETTLE_FLOOR)); then
+  echo "the deforming window left the cancelled slide instead of travelling with it (green=$cancelled)"
+  exit 1
+fi
+settle_assert_travelled "into a cancelled swipe" "$wx $wy $ww $wh" "$cx $cy $cw $ch" 120
+if [[ $cancelled_workspace != ONE || $cancelled_after -lt SETTLE_FLOOR ]]; then
+  echo "a cancelled swipe did not leave the window on its workspace (workspace $cancelled_workspace, green=$cancelled_after)"
+  exit 1
+fi
+if ((committed < SETTLE_FLOOR)); then
+  echo "the window left the committed slide instead of travelling with it (green=$committed)"
+  exit 1
+fi
+settle_assert_travelled "into a committed swipe" "$wx $wy $ww $wh" "$mx $my $mw $mh" 120
+if [[ $committed_workspace != TWO ]]; then
+  echo "the committed swipe did not switch workspace: on '$committed_workspace', want TWO"
+  exit 1
+fi
+if ((committed_away >= SETTLE_FLOOR)); then
+  echo "the window stayed on screen after its workspace left (green=$committed_away)"
+  exit 1
+fi
+echo "a deforming window travels and hides with a gesture, cancelled or committed"
diff --git a/tests/harness/checks/drag/settle_workspace_switch.sh b/tests/harness/checks/drag/settle_workspace_switch.sh
new file mode 100755
index 00000000..38bf82f3
--- /dev/null
+++ b/tests/harness/checks/drag/settle_workspace_switch.sh
@@ -0,0 +1,117 @@
+#!/usr/bin/env bash
+# harness: outputs=1
+# A window that still deforms must not outlive the workspace it lives in. The
+# drag physics keeps a released sheet displaced past the drop and the deferred
+# re-home leaves it under the shared drag tree, outside every workspace layer, so
+# the workspace's slide offset and clip never reach it: it hangs at its old screen
+# position after its workspace has gone. It must slide out with the workspace,
+# come back with it, and leave no residue once the slow spring has run out.
+#
+# The switch is an activate (not a gesture), so the workspace is deactivated at
+# once and the flight is ordered on the frozen clock.
+#
+# Accepted limit, unpinned: opening the overview mid-settle flushes every waiting
+# re-home (its cards need the home trees), so the drawing this check preserves is
+# deliberately sacrificed there; a regression to "overview flushes nothing" passes.
+set -euo pipefail
+source "$UMBRIEL_REPO/tests/harness/drag_settle_lib.sh"
+
+readonly TITLE=stuck-sheet
+readonly SPAN="${SETTLE_OUTPUT_W}x${SETTLE_OUTPUT_H}"
+
+settle_config
+settle_sheet_rule "$TITLE"
+# Static workspaces: a dynamic inventory would prune the emptied workspace and
+# move the window instead of leaving it where the check put it.
+cat >> "$UMBRIEL_CONFIG" <<'EOF'
+
+[output.HEADLESS-1]
+position = [0, 0]
+workspaces = ["ONE", "TWO"]
+EOF
+"$UMBRIEL" msg config-reload > /dev/null
+
+settle_map "$TITLE" 400 300 0xFF00FF00
+settle_sheet_extent "$TITLE"
+readonly bw=$SETTLE_SHEET_WIDTH bh=$SETTLE_SHEET_HEIGHT
+
+settle_drag_queue "$TITLE" "$SPAN"
+"$UMBRIEL" clock-freeze
+"$UMBRIEL" clock-advance 16 > /dev/null
+held=$(settle_green)
+pointer_release
+"$UMBRIEL" clock-advance 16 > /dev/null
+settle_require_deforming "switch"
+
+if [[ $(settle_workspace_name "$(settle_workspace "$TITLE")") != ONE || $(settle_active_workspace) != ONE ]]; then
+  echo "scenario never engaged: window and active workspace want ONE/ONE"
+  exit 1
+fi
+if ((held < SETTLE_FLOOR)); then
+  echo "scenario never engaged: the deformed sheet does not draw before the switch (green=$held)"
+  exit 1
+fi
+read -r wx wy ww wh < <(settle_box "$TITLE")
+
+read -r px py _ _ < <(settle_green_bbox)
+"$UMBRIEL" msg workspace-switch TWO > /dev/null
+# The switch is dispatched asynchronously, so the slide can begin after the next
+# ordered tick: advance until the sheet has travelled. This output arranges its
+# workspaces vertically (the default axis, no `workspace_axis` override) while the
+# drag displaced the sheet horizontally, so vertical motion here is the slide.
+advanced=0
+while :; do
+  "$UMBRIEL" clock-advance 16 > /dev/null
+  ((advanced += 16))
+  read -r _ ny _ _ < <(settle_green_bbox)
+  dy=$((ny - py))
+  ((dy < 0)) && dy=$((-dy))
+  ((dy >= 120)) && break
+  if ((advanced >= 240)); then
+    echo "the deforming window did not travel with its workspace: still drawn at y=$ny (was $py) through the whole slide"
+    exit 1
+  fi
+done
+mid=$(settle_green)
+read -r mx my mw mh < <(settle_green_bbox)
+"$UMBRIEL" clock-advance 400 > /dev/null
+away=$(settle_green)
+active_after=$(settle_active_workspace)
+
+if [[ $active_after != TWO ]]; then
+  echo "the switch never happened: on workspace '$active_after', want TWO"
+  exit 1
+fi
+if ((mid < SETTLE_FLOOR)); then
+  echo "the deforming window left the slide instead of travelling with it (green=$mid halfway)"
+  exit 1
+fi
+settle_assert_travelled "mid-slide" "$wx $wy $ww $wh" "$mx $my $mw $mh" 120
+if ((away >= SETTLE_FLOOR)); then
+  echo "the deforming window stayed on screen after its workspace left (green=$away)"
+  exit 1
+fi
+
+# Switching back presents it again at rest on its committed box once the slow
+# spring has run out; the clock stays frozen so that settle is ordered here.
+"$UMBRIEL" msg workspace-switch ONE > /dev/null
+"$UMBRIEL" clock-advance 300 > /dev/null
+"$UMBRIEL" clock-advance 6000 > /dev/null
+back=$(settle_green)
+read -r _ _ rw rh < <(settle_green_bbox)
+"$UMBRIEL" clock-resume
+"$UMBRIEL" settle > /dev/null
+
+if [[ $(settle_workspace_name "$(settle_workspace "$TITLE")") != ONE ]]; then
+  echo "the release moved the window off its workspace, want ONE"
+  exit 1
+fi
+if ((back < SETTLE_FLOOR)); then
+  echo "the window did not come back with its workspace (green=$back)"
+  exit 1
+fi
+if (((rw - bw) > 2 || (bw - rw) > 2 || (rh - bh) > 2 || (bh - rh) > 2)); then
+  echo "the deform left a residue once it settled: drawn ${rw}x${rh}, resting ${bw}x${bh}"
+  exit 1
+fi
+echo "a deforming window slides out and back with its workspace and settles clean"
diff --git a/tests/harness/checks/drag/settle_workspace_transfer.sh b/tests/harness/checks/drag/settle_workspace_transfer.sh
new file mode 100755
index 00000000..26a2097c
--- /dev/null
+++ b/tests/harness/checks/drag/settle_workspace_transfer.sh
@@ -0,0 +1,98 @@
+#!/usr/bin/env bash
+# harness: outputs=2
+# Moving a workspace to another output while one of its windows still deforms
+# must land the released sheet's re-home first. The sheet is parked under the
+# shared drag tree, outside every workspace tree, so a transfer that travels them
+# without landing it draws the sheet at its old SCREEN position and rewrites its
+# position in the old output's coordinates, so the settle lands it twice.
+#
+# The transfer also deactivates the workspace, which lands the wait on its own:
+# this pins the user-visible result and the ordering, not the flush alone.
+set -euo pipefail
+source "$UMBRIEL_REPO/tests/harness/drag_settle_lib.sh"
+
+readonly TITLE=transfer-sheet
+readonly SPAN="2560x$SETTLE_OUTPUT_H"
+
+settle_config
+settle_sheet_rule "$TITLE"
+# Static workspaces with names unique per output: the transfer moves the named
+# workspace, and a dynamic inventory would renumber it out from under the
+# assertion.
+cat >> "$UMBRIEL_CONFIG" <<'EOF'
+
+[output.HEADLESS-1]
+position = [0, 0]
+workspaces = ["ONE", "TWO"]
+[output.HEADLESS-2]
+position = [1280, 0]
+workspaces = ["THREE", "FOUR"]
+EOF
+"$UMBRIEL" msg config-reload > /dev/null
+
+settle_map "$TITLE" 400 300 0xFF00FF00
+
+home_out=$(settle_workspace "$TITLE")
+home_out=${home_out%%:*}
+if [[ $home_out == HEADLESS-1 ]]; then dest_out=HEADLESS-2; else dest_out=HEADLESS-1; fi
+workspace=$(settle_workspace_name "$(settle_workspace "$TITLE")")
+if [[ -z $workspace ]]; then
+  echo "scenario never engaged: the window reports a workspace with no name"
+  exit 1
+fi
+
+before_home=$(settle_green "$home_out")
+before_dest=$(settle_green "$dest_out")
+if ((before_home < SETTLE_FLOOR)); then
+  echo "scenario never engaged: the window does not draw on $home_out (green=$before_home)"
+  exit 1
+fi
+if ((before_dest >= SETTLE_FLOOR)); then
+  echo "scenario never engaged: the window already draws on $dest_out before the transfer (green=$before_dest)"
+  exit 1
+fi
+
+settle_drag_queue "$TITLE" "$SPAN"
+"$UMBRIEL" clock-freeze
+"$UMBRIEL" clock-advance 16 > /dev/null
+# The release runs on the helper's queued step, so it must happen before anything
+# that asserts the released spring or the transfer: a held sheet is a different
+# scenario (see settle_held_workspace_switch).
+pointer_release
+"$UMBRIEL" clock-advance 16 > /dev/null
+settle_require_deforming "transfer" "$home_out"
+settling_home=$(settle_green "$home_out")
+
+# The transfer is the operation under test: it reparents the workspace trees.
+"$UMBRIEL" msg workspace-move-to-output "$dest_out" "$workspace" > /dev/null
+"$UMBRIEL" clock-advance 60 > /dev/null
+moved_home=$(settle_green "$home_out")
+moved_dest=$(settle_green "$dest_out")
+# Run the slow spring out on the ordered clock: resuming here would spend its
+# whole drain in wall time before the landing could be sampled.
+"$UMBRIEL" clock-advance 6000 > /dev/null
+landed_home=$(settle_green "$home_out")
+landed_dest=$(settle_green "$dest_out")
+"$UMBRIEL" clock-resume
+
+if ((settling_home < SETTLE_FLOOR)); then
+  echo "scenario never engaged: the released sheet does not draw on $home_out before the transfer (green=$settling_home)"
+  exit 1
+fi
+if ((moved_dest < SETTLE_FLOOR)); then
+  echo "the transferred sheet did not appear on $dest_out with its workspace (green=$moved_dest)"
+  exit 1
+fi
+if ((moved_home >= SETTLE_FLOOR)); then
+  echo "the settling window stayed on $home_out after its workspace moved (green=$moved_home)"
+  exit 1
+fi
+if ((landed_home >= SETTLE_FLOOR)); then
+  echo "the window came back to $home_out once the deform settled (green=$landed_home)"
+  exit 1
+fi
+if ((landed_dest < SETTLE_FLOOR)); then
+  echo "the sheet left $dest_out once the deform settled (green=$landed_dest)"
+  exit 1
+fi
+echo "a settling window moves outputs with its workspace, and stays where it landed"
diff --git a/tests/harness/drag_settle_lib.sh b/tests/harness/drag_settle_lib.sh
new file mode 100644
index 00000000..7438f2ec
--- /dev/null
+++ b/tests/harness/drag_settle_lib.sh
@@ -0,0 +1,186 @@
+# Shared by the checks that pin what a released, still-deforming sheet does while
+# its workspace moves. A released sheet rests under the shared drag tree, outside
+# every workspace layer, until its spring settles; the drag that carries a window
+# also carries its transient children. Each check adds one scenario to this desktop.
+source "$UMBRIEL_HARNESS_LIB"
+
+readonly SETTLE_BTN_LEFT=272
+readonly SETTLE_OUTPUT_W=1280
+readonly SETTLE_OUTPUT_H=720
+readonly SETTLE_REGION="${SETTLE_OUTPUT_W}x${SETTLE_OUTPUT_H}+0+0"
+readonly SETTLE_IMAGE="$UMBRIEL_RUNTIME_DIR/settle.png"
+# A quarter of a 400x300 sheet: proof it is drawn, not a stray edge.
+readonly SETTLE_FLOOR=20000
+# A dialog's 200x150 face is smaller than a full sheet.
+readonly SETTLE_DIALOG_FLOOR=5000
+# Every drag below travels this far: enough to engage the spring's displacement.
+readonly SETTLE_TRAVEL=120
+
+# Floating-only desktop, instant animations, a slow drag spring so the sheet stays
+# displaced far past whatever the check orders next, and a linear 300 ms slide
+# (the default workspace curve is a spring and ignores duration_ms).
+settle_config() {
+  cat >> "$UMBRIEL_CONFIG" <<'CONFIG'
+
+[layout]
+mode = "floating"
+
+[input.focus]
+follows_mouse = false
+
+[colors]
+backdrop = "#000000FF"
+[appearance]
+border_width = 0
+outer_border_width = 0
+corner_radius = 0
+drag_opacity = 1.0
+[appearance.shadow]
+enabled = false
+[animation]
+duration_ms = 1
+[animation.windows_in]
+enabled = false
+[animation.windows_out]
+enabled = false
+[animation.windows_drag]
+physics = true
+stiffness = 1.0
+damping = 1.0
+max_displacement_px = 200
+[animation.workspaces]
+enabled = true
+duration_ms = 300
+curve = "linear"
+CONFIG
+}
+
+# A sheet the checks drag: floating, a fixed size, sized for the pixel floors.
+settle_sheet_rule() { # $1 title
+  cat >> "$UMBRIEL_CONFIG" <<CONFIG
+
+[[window_rule]]
+match.title = "^$1\$"
+default_floating = true
+default_floating_size_px = { width = 400, height = 300 }
+CONFIG
+}
+
+# Maps `title` filled with `color` and waits until the compositor lists it.
+settle_map() { # $1 title, $2 width, $3 height, $4 fill colour
+  FILL_COLOR=$4 "$UMBRIEL_UNMAP_CLIENT" "$1" "$2" "$3" > "$UMBRIEL_RUNTIME_DIR/$1.log" 2>&1 &
+  await_window "$1"
+  "$UMBRIEL" settle > /dev/null
+}
+
+# A parent toplevel and a dialog parented to it through a foreign handle, left
+# unattached so the dialog keeps its own scene node: a workspace that hides it is
+# then visible on screen instead of riding the parent's node.
+settle_map_dialog() { # $1 parent title, $2 dialog title
+  EXPORT_TOPLEVEL=1 "$UMBRIEL_SEAT_LOG_CLIENT" "$1" > "$UMBRIEL_RUNTIME_DIR/$1.log" 2>&1 &
+  await_window "$1"
+  await_lines "$UMBRIEL_RUNTIME_DIR/$1.log" "exported handle=" 1
+  local handle
+  handle=$(sed -n 's/^exported handle=//p' "$UMBRIEL_RUNTIME_DIR/$1.log")
+  TRANSIENT_FOREIGN_HANDLE=$handle FILL_COLOR=0xFFFF0000 "$UMBRIEL_UNMAP_CLIENT" "$2" 200 150 \
+    > "$UMBRIEL_RUNTIME_DIR/$2.log" 2>&1 &
+  await_window "$2"
+  "$UMBRIEL" settle > /dev/null
+}
+
+settle_box() { window_by_title "$1" | jq -r '"\(.x) \(.y) \(.w) \(.h)"'; }
+settle_id() { window_by_title "$1" | jq -r '.id'; }
+settle_workspace() { window_by_title "$1" | jq -r '.workspace'; }
+settle_workspace_name() { # $1 workspace id, as `windows` reports it
+  "$UMBRIEL" workspaces --json | jq -r --arg id "$1" '.[] | select(.id == $id) | .name'
+}
+settle_active_workspace() { "$UMBRIEL" workspaces --json | jq -r '.[] | select(.active) | .name'; }
+
+# Presses super+left at (gx,gy) and travels SETTLE_TRAVEL in three steps. `hold`
+# leaves the button down; `release` queues the release, which runs when
+# pointer_release kicks the helper.
+settle_press() { # $1 pointer span "WxH", $2 gx, $3 gy, $4 hold|release
+  local -a commands=(
+    move "$2" "$3" mod super press "$SETTLE_BTN_LEFT"
+    move $(($2 + 40)) "$3" move $(($2 + 80)) "$3" move $(($2 + SETTLE_TRAVEL)) "$3"
+  )
+  [[ $4 == release ]] && commands+=(-- release "$SETTLE_BTN_LEFT" mod none)
+  pointer_hold "${1%x*}" "${1#*x}" "${commands[@]}"
+}
+
+# Grabs `title`'s centre: the sheet follows the cursor from where it rests.
+settle_drag() { # $1 title, $2 span "WxH", $3 hold|release
+  local x y w h
+  read -r x y w h <<< "$(settle_box "$1")"
+  settle_press "$2" $((x + w / 2)) $((y + h / 2)) "$3"
+}
+
+# Grabs `title` a quarter in from a corner, clear of the dialog the compositor
+# centres over a parent.
+settle_drag_corner() { # $1 title, $2 span "WxH", $3 hold|release
+  local x y w h
+  read -r x y w h <<< "$(settle_box "$1")"
+  settle_press "$2" $((x + w / 4)) $((y + h * 3 / 4)) "$3"
+}
+
+settle_drag_hold() { settle_drag "$1" "$2" hold; }
+settle_drag_queue() { settle_drag "$1" "$2" release; }
+
+settle_shot() { grim -o "${1:-HEADLESS-1}" "$SETTLE_IMAGE"; }
+settle_green() { settle_shot "${1:-}"; "$UMBRIEL_PIXEL_PROBE" "$SETTLE_IMAGE" count 'g > 0.8 && r < 0.2 && b < 0.2'; }
+settle_red() { settle_shot "${1:-}"; "$UMBRIEL_PIXEL_PROBE" "$SETTLE_IMAGE" count 'r > 0.8 && g < 0.2 && b < 0.2'; }
+settle_green_bbox() { settle_shot "${1:-}"; "$UMBRIEL_PIXEL_PROBE" "$SETTLE_IMAGE" bbox 'g > 0.8 && r < 0.2 && b < 0.2'; }
+
+# Every other animation in this config is 1 ms, so a sheet that does not change
+# across an ordered tick means the deform never engaged and the deferral under
+# test was never taken.
+settle_require_deforming() { # $1 label, [$2 output]
+  local before="$UMBRIEL_RUNTIME_DIR/deform-before.png" _ changed
+  settle_shot "${2:-HEADLESS-1}"
+  cp "$SETTLE_IMAGE" "$before"
+  "$UMBRIEL" clock-advance 200 > /dev/null
+  settle_shot "${2:-HEADLESS-1}"
+  read -r _ changed < <("$UMBRIEL_PIXEL_PROBE" "$before" diff "$SETTLE_IMAGE" "$SETTLE_REGION")
+  if ((changed == 0)); then
+    echo "$1: the released sheet is not deforming (no pixel moved in 200 ms), the wait was never taken"
+    exit 1
+  fi
+}
+
+# The drawn sheet must have travelled with its workspace: still drawn, and moved
+# along whichever axis this output arranges workspaces on by a large share of the
+# slide, or clipped at the edge it left through. A view parked under the shared
+# drag tree keeps drawing at its own coordinates.
+settle_assert_travelled() { # $1 label, $2 box "x y w h", $3 drawn bbox, $4 minimum shift
+  local label=$1 bxx bxy bxw bxh drx dry drw drh
+  read -r bxx bxy bxw bxh <<< "$2"
+  read -r drx dry drw drh <<< "$3"
+  local dx=$((drx - bxx)) dy=$((dry - bxy))
+  ((dx < 0)) && dx=$((-dx))
+  ((dy < 0)) && dy=$((-dy))
+  local moved=$((dx > dy ? dx : dy))
+  ((moved >= $4)) && return 0
+  # Clipped against the edge it travelled out through, and drawn smaller than its
+  # own box: the sheet really moved out, it did not just change shape. Requiring
+  # the box to have started at least the minimum away rejects a window that
+  # already sat on the edge.
+  if ((((drx <= 1 && bxx >= $4) || (dry <= 1 && bxy >= $4)) && drw * drh < bxw * bxh)); then
+    return 0
+  fi
+  echo "$label: the deforming window did not travel with its workspace (drawn at ${drx},${dry}, box ${bxx},${bxy})"
+  exit 1
+}
+
+# The green sheet's drawn extent, after checking it is drawn at all: a deform
+# assertion against a window that never mapped would pass vacuously. Sets
+# SETTLE_SHEET_WIDTH and SETTLE_SHEET_HEIGHT in the caller's shell, so the floor
+# below can fail the check rather than a subshell.
+settle_sheet_extent() { # $1 sheet title
+  local w h
+  read -r _ _ w h <<< "$(settle_box "$1")"
+  read -r _ _ SETTLE_SHEET_WIDTH SETTLE_SHEET_HEIGHT < <(settle_green_bbox)
+  if ((SETTLE_SHEET_WIDTH < w / 2 || SETTLE_SHEET_HEIGHT < h / 2)); then
+    echo "scenario never engaged: the window draws ${SETTLE_SHEET_WIDTH}x${SETTLE_SHEET_HEIGHT} in a ${w}x${h} box"
+    exit 1
+  fi
+}
