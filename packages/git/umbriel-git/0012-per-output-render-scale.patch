diff --git a/tests/harness/checks/protocol/render_scale.sh b/tests/harness/checks/protocol/render_scale.sh
new file mode 100644
index 00000000..4ff12fe7
--- /dev/null
+++ b/tests/harness/checks/protocol/render_scale.sh
@@ -0,0 +1,131 @@
+#!/usr/bin/env bash
+# harness: outputs=1
+# render_scale supersedes the logical scale in the client scale hints alone: a
+# fractional client must be asked to render at render_scale (its buffer grows to
+# floor(logical x render_scale)) while the output keeps presenting the logical
+# scale. Dropping the key on a reload must re-notify the client back to the
+# logical scale.
+set -euo pipefail
+source "$UMBRIEL_HARNESS_LIB"
+
+readonly CLIENT="${UMBRIEL_FRACTIONAL_CLIENT:-./build-debug/tests/fractional-client}"
+readonly CLIENT_LOG="$UMBRIEL_RUNTIME_DIR/render-scale-client.log"
+
+cat >> "$UMBRIEL_CONFIG" <<'EOF'
+
+[[window_rule]]
+match.title = "^render-scale$"
+default_floating = true
+default_floating_size_px = { width = 400, height = 300 }
+default_position = { x = 40, y = 40, anchor = "top_left" }
+
+[output."HEADLESS-1"]
+scale = 1.25
+render_scale = 2.0
+workspaces = 2
+EOF
+"$UMBRIEL" msg config-reload > /dev/null
+
+"$CLIENT" render-scale 400 300 > "$CLIENT_LOG" 2>&1 &
+for _ in $(seq 60); do
+  grep -q '^mapped ' "$CLIENT_LOG" && break
+  sleep 0.05
+done
+
+presented=$(grep '^mapped ' "$CLIENT_LOG" | tail -1)
+echo "presented at render_scale: $presented"
+if [[ $presented != *"buffer 800x600"* || $presented != *"scale 240/120"* ]]; then
+  echo "the client was not asked to render at render_scale 2.0"
+  exit 1
+fi
+
+scale_shown=$("$UMBRIEL" outputs | awk '/Scale:/ { print $2; exit }')
+render_shown=$("$UMBRIEL" outputs | awk '/Render scale:/ { print $3; exit }')
+echo "outputs: Scale=$scale_shown Render scale=$render_shown"
+awk -v a="$scale_shown" 'BEGIN { exit !(a + 0 == 1.25) }' || {
+  echo "the output stopped presenting the logical scale"
+  exit 1
+}
+awk -v a="$render_shown" 'BEGIN { exit !(a + 0 == 2.0) }' || {
+  echo "umbriel outputs does not report the render scale"
+  exit 1
+}
+
+before=$(grep -c '^mapped ' "$CLIENT_LOG")
+sed -i '/render_scale/d' "$UMBRIEL_CONFIG"
+"$UMBRIEL" msg config-reload > /dev/null
+if ! await_lines "$CLIENT_LOG" 'mapped ' $((before + 1)) 0.05; then
+  echo "dropping render_scale produced no new presentation to assert on"
+  exit 1
+fi
+
+presented=$(grep '^mapped ' "$CLIENT_LOG" | tail -1)
+echo "presented after reload: $presented"
+if [[ $presented != *"buffer 500x375"* || $presented != *"scale 150/120"* ]]; then
+  echo "dropping render_scale did not re-notify the client back to the logical scale"
+  exit 1
+fi
+
+# A render scale below the logical scale is legal and must reach the client
+# unchanged.
+before=$(grep -c '^mapped ' "$CLIENT_LOG")
+printf 'render_scale = 0.5\n' >> "$UMBRIEL_CONFIG"
+"$UMBRIEL" msg config-reload > /dev/null
+if ! await_lines "$CLIENT_LOG" 'mapped ' $((before + 1)) 0.05; then
+  echo "a render_scale below the logical scale produced no new presentation to assert on"
+  exit 1
+fi
+
+presented=$(grep '^mapped ' "$CLIENT_LOG" | tail -1)
+echo "presented below the logical scale: $presented"
+if [[ $presented != *"buffer 200x150"* || $presented != *"scale 60/120"* ]]; then
+  echo "a render_scale below the logical scale did not reach the client"
+  exit 1
+fi
+
+# Hiding and revealing the surface (a workspace round-trip) makes the scene
+# re-derive the hint: a sub-1 render scale must survive the re-derivation too.
+# The reveal re-presents the surface, so assert on a FRESH mapped line
+# (count-polled): a same-scale re-notify is deduped below the wire, and reading
+# the previous line would pass vacuously without the round-trip doing anything.
+before=$(grep -c '^mapped ' "$CLIENT_LOG")
+"$UMBRIEL" msg workspace-next > /dev/null
+"$UMBRIEL" msg workspace-previous > /dev/null
+if ! await_lines "$CLIENT_LOG" 'mapped ' $((before + 1)) 0.05; then
+  echo "the workspace round-trip produced no new presentation to assert on"
+  exit 1
+fi
+presented=$(grep '^mapped ' "$CLIENT_LOG" | tail -1)
+echo "presented after a workspace round-trip: $presented"
+if [[ $presented != *"scale 60/120"* ]]; then
+  echo "the scene re-derivation dropped the below-logical render scale ($presented)"
+  exit 1
+fi
+# An unset render_scale follows `scale` but never shrinks client buffers, so a
+# legal logical scale below 1 keeps the hint at the neutral 1.0 (120/120)
+# rather than following 0.8.
+sed -i '/render_scale/d' "$UMBRIEL_CONFIG"
+sed -i 's/^scale = 1\.25$/scale = 0.8/' "$UMBRIEL_CONFIG"
+"$UMBRIEL" msg config-reload > /dev/null
+readonly SUB1_LOG="$UMBRIEL_RUNTIME_DIR/render-scale-sub1-client.log"
+# Same title as the first client so the window rule that sizes it applies.
+"$CLIENT" render-scale 400 300 > "$SUB1_LOG" 2>&1 &
+for _ in $(seq 60); do
+  grep -q '^mapped ' "$SUB1_LOG" && break
+  sleep 0.05
+done
+presented=$(grep '^mapped ' "$SUB1_LOG" | tail -1)
+echo "presented at a sub-1 logical scale: $presented"
+if [[ $presented != *"buffer 400x300"* || $presented != *"scale 120/120"* ]]; then
+  echo "an unset render_scale followed a sub-1 logical scale into the client hint ($presented)"
+  exit 1
+fi
+# The floor belongs to the hint alone: the configured value other consumers see
+# (IPC, the startup/reload log, the X11 mapping) still follows `scale`.
+reported=$("$UMBRIEL" outputs --json | jq -r '.[] | select(.name == "HEADLESS-1") | .render_scale')
+if ! awk -v value="$reported" 'BEGIN { delta = value - 0.8; exit !(delta < 0.001 && delta > -0.001) }'; then
+  echo "outputs reports render_scale $reported for an unset key on a 0.8 output"
+  exit 1
+fi
+
+echo "render_scale drives the client hints and falls back to the logical scale on reload"
diff --git a/tests/harness/checks/protocol/render_scale_exempt.sh b/tests/harness/checks/protocol/render_scale_exempt.sh
new file mode 100755
index 00000000..9273a118
--- /dev/null
+++ b/tests/harness/checks/protocol/render_scale_exempt.sh
@@ -0,0 +1,119 @@
+#!/usr/bin/env bash
+# harness: outputs=1
+# Windows that skip the render_scale supersample: fullscreen windows and game or
+# video content are asked to render at the logical scale, so a fullscreen buffer
+# is the output's physical mode and never the render-scale size. Leaving
+# fullscreen supersamples again, and a `supersample` window rule overrides both
+# directions.
+set -euo pipefail
+source "$UMBRIEL_HARNESS_LIB"
+source "$UMBRIEL_REPO/tests/harness/scale_lib.sh"
+
+readonly CLIENT="${UMBRIEL_FRACTIONAL_CLIENT:-./build-debug/tests/fractional-client}"
+readonly PLAIN_LOG="$UMBRIEL_RUNTIME_DIR/render-scale-plain.log"
+readonly GAME_LOG="$UMBRIEL_RUNTIME_DIR/render-scale-game.log"
+
+cat >> "$UMBRIEL_CONFIG" <<'EOF'
+
+[[window_rule]]
+match.title = "^rs-"
+default_floating = true
+default_floating_size_px = { width = 400, height = 300 }
+default_position = { x = 40, y = 40, anchor = "top_left" }
+
+[output."HEADLESS-1"]
+scale = 1.25
+render_scale = 2.0
+EOF
+"$UMBRIEL" msg config-reload > /dev/null
+
+# Waits for one more presentation than `before` and prints the newest one.
+next_presentation() {
+  local log=$1 before=$2
+  await_lines "$log" 'mapped ' $((before + 1)) 0.05 > /dev/null || {
+    echo "no new presentation in $log: $(tr '\n' '|' < "$log")" >&2
+    return 1
+  }
+  grep '^mapped ' "$log" | tail -1
+}
+
+"$CLIENT" rs-plain 400 300 > "$PLAIN_LOG" 2>&1 &
+presented=$(next_presentation "$PLAIN_LOG" 0)
+echo "plain window: $presented"
+expect_hint "$presented" "scale 240/120" "a plain window was not supersampled"
+
+output_size=$("$UMBRIEL" outputs --json | jq -r '.[0].modes[] | select(.current) | "\(.width)x\(.height)"')
+"$UMBRIEL" msg window-toggle-fullscreen > /dev/null
+# The hint goes out ahead of the fullscreen configure, so the eager test
+# client can present once at the old size with the new scale. Wait for the
+# fullscreen presentation itself, then assert on it.
+await_lines "$PLAIN_LOG" "mapped .*buffer $output_size " 1 0.05 > /dev/null || {
+  echo "no fullscreen presentation in $PLAIN_LOG: $(tr '\n' '|' < "$PLAIN_LOG")" >&2
+  exit 1
+}
+presented=$(grep '^mapped ' "$PLAIN_LOG" | grep "buffer $output_size " | tail -1)
+echo "fullscreen on a ${output_size} output: $presented"
+expect_hint "$presented" "scale 150/120" "a fullscreen window was asked to render at render_scale"
+expect_hint "$presented" "buffer $output_size" "a fullscreen buffer is not the output's physical mode"
+
+before=$(grep -c '^mapped ' "$PLAIN_LOG")
+"$UMBRIEL" msg window-toggle-fullscreen > /dev/null
+presented=$(next_presentation "$PLAIN_LOG" "$before")
+echo "after fullscreen: $presented"
+expect_hint "$presented" "scale 240/120" "leaving fullscreen did not supersample again"
+
+CONTENT_TYPE=game "$CLIENT" rs-game 400 300 > "$GAME_LOG" 2>&1 &
+presented=$(next_presentation "$GAME_LOG" 0)
+echo "game window: $presented"
+expect_hint "$presented" "scale 150/120" "a game window was supersampled"
+
+# Rules decide outright: the game opts in, the plain window opts out.
+before_game=$(grep -c '^mapped ' "$GAME_LOG")
+before_plain=$(grep -c '^mapped ' "$PLAIN_LOG")
+cat >> "$UMBRIEL_CONFIG" <<'EOF'
+
+[[window_rule]]
+match.title = "^rs-game$"
+supersample = true
+
+[[window_rule]]
+match.title = "^rs-plain$"
+supersample = false
+EOF
+"$UMBRIEL" msg config-reload > /dev/null
+presented=$(next_presentation "$GAME_LOG" "$before_game")
+echo "game window with supersample = true: $presented"
+expect_hint "$presented" "scale 240/120" "supersample = true did not override the game content type"
+presented=$(next_presentation "$PLAIN_LOG" "$before_plain")
+echo "plain window with supersample = false: $presented"
+expect_hint "$presented" "scale 150/120" "supersample = false did not keep the window at the logical scale"
+
+# A content type can change after mapping: a browser or media player becomes
+# `video` when playback starts in an existing window. That path never sees a new
+# initial commit, so only View::syncContentType can move the hint.
+readonly DYNAMIC_LOG="$UMBRIEL_RUNTIME_DIR/render-scale-dynamic.log"
+readonly DYNAMIC_FIFO="$UMBRIEL_RUNTIME_DIR/render-scale-dynamic.fifo"
+mkfifo "$DYNAMIC_FIFO"
+exec {dynamic}<> "$DYNAMIC_FIFO"
+CONTENT_TYPE_CONTROL=1 "$CLIENT" rs-dynamic 400 300 <&"$dynamic" > "$DYNAMIC_LOG" 2>&1 &
+presented=$(next_presentation "$DYNAMIC_LOG" 0)
+echo "dynamic content window: $presented"
+expect_hint "$presented" "scale 240/120" "a plain window was not supersampled"
+
+set_content_type() { # type, expected hint, message
+  local before
+  before=$(grep -c '^mapped ' "$DYNAMIC_LOG")
+  printf 'content-type %s\n' "$1" >&"$dynamic"
+  local presented
+  presented=$(next_presentation "$DYNAMIC_LOG" "$before")
+  echo "content-type $1 on a mapped window: $presented"
+  expect_hint "$presented" "$2" "$3"
+}
+# Alternate exempt and normal so every toggle changes the hint; a same-value
+# re-notify is deduped below the wire and would assert nothing.
+set_content_type game "scale 150/120" "a game content type set after mapping did not exempt the window"
+set_content_type none "scale 240/120" "clearing the content type did not supersample again"
+set_content_type video "scale 150/120" "a video content type set after mapping did not exempt the window"
+set_content_type none "scale 240/120" "clearing the video content type did not supersample again"
+
+echo "fullscreen and game windows skip the supersample, rules override both ways, and a later content type follows"
diff --git a/tests/harness/checks/protocol/render_scale_layer_exempt.sh b/tests/harness/checks/protocol/render_scale_layer_exempt.sh
new file mode 100755
index 00000000..dd0fe61c
--- /dev/null
+++ b/tests/harness/checks/protocol/render_scale_layer_exempt.sh
@@ -0,0 +1,82 @@
+#!/usr/bin/env bash
+# harness: outputs=1
+# Layer surfaces supersample like windows, and a `supersample = false` layer rule
+# keeps one at the logical scale: a screenshot overlay showing a frozen capture
+# would otherwise scale that capture up to the render scale and back down.
+# Reloading the rule away supersamples the mapped surface again, and a surface
+# that was unmapped when the rule arrived carries it from the commit that maps
+# it. A popup follows its layer surface, but the test client logs no popup hint,
+# so that leg is not pinned here.
+set -euo pipefail
+source "$UMBRIEL_HARNESS_LIB"
+source "$UMBRIEL_REPO/tests/harness/scale_lib.sh"
+
+readonly LOG="$UMBRIEL_RUNTIME_DIR/render-scale-layer.log"
+
+# Appends the layer rule the client's namespace matches, supersampling or not.
+write_rule() { # true or false
+  cat >> "$UMBRIEL_CONFIG" <<RULE
+
+[[layer_rule]]
+match.namespace = "^umbriel-output-restore-regression$"
+supersample = $1
+RULE
+}
+
+cat >> "$UMBRIEL_CONFIG" <<'CONFIG'
+
+[output."HEADLESS-1"]
+scale = 1.25
+render_scale = 2.0
+CONFIG
+"$UMBRIEL" msg config-reload > /dev/null
+
+"$UMBRIEL_LAYER_CLIENT" HEADLESS-1 0 overlay-layer log-scale > "$LOG" 2>&1 &
+hint=$(nth_hint "$LOG" 'scale ' 1)
+echo "overlay layer: $hint"
+expect_hint "$hint" "scale 240/120" "a layer surface was not supersampled"
+
+# A rule added after the surface mapped reaches it on reload.
+before=$(grep -c 'scale ' "$LOG")
+write_rule false
+"$UMBRIEL" msg config-reload > /dev/null
+hint=$(nth_hint "$LOG" 'scale ' $((before + 1)))
+echo "overlay layer with supersample = false: $hint"
+expect_hint "$hint" "scale 150/120" "supersample = false did not keep the layer surface at the logical scale"
+
+before=$(grep -c 'scale ' "$LOG")
+sed -i 's/^supersample = false$/supersample = true/' "$UMBRIEL_CONFIG"
+"$UMBRIEL" msg config-reload > /dev/null
+hint=$(nth_hint "$LOG" 'scale ' $((before + 1)))
+echo "overlay layer with supersample = true: $hint"
+expect_hint "$hint" "scale 240/120" "lifting the layer rule did not supersample the surface again"
+
+# A rule already in effect when the surface is created is the usual case: a config file, not a reload.
+sed -i 's/^supersample = true$/supersample = false/' "$UMBRIEL_CONFIG"
+"$UMBRIEL" msg config-reload > /dev/null
+readonly MAPPED_LOG="$UMBRIEL_RUNTIME_DIR/render-scale-layer-mapped.log"
+"$UMBRIEL_LAYER_CLIENT" HEADLESS-1 0 overlay-layer log-scale > "$MAPPED_LOG" 2>&1 &
+hint=$(nth_hint "$MAPPED_LOG" 'scale ' 1)
+echo "overlay layer created under the rule: $hint"
+expect_hint "$hint" "scale 150/120" "a rule in place at creation did not keep the layer surface at the logical scale"
+
+# A reload only reaches mapped surfaces, so a rule that arrives while the surface is still uncommitted has to be
+# resolved again by the commit that maps it.
+sed -i 's/^supersample = false$/supersample = true/' "$UMBRIEL_CONFIG"
+"$UMBRIEL" msg config-reload > /dev/null
+readonly HELD_LOG="$UMBRIEL_RUNTIME_DIR/render-scale-layer-held.log"
+readonly HELD_FIFO="$UMBRIEL_RUNTIME_DIR/render-scale-layer-held.fifo"
+mkfifo "$HELD_FIFO"
+LAYER_CONTROL=1 "$UMBRIEL_LAYER_CLIENT" HEADLESS-1 0 overlay-layer log-scale hold-map < "$HELD_FIFO" > "$HELD_LOG" 2>&1 &
+exec 5> "$HELD_FIFO"
+await_lines "$HELD_LOG" 'held$' 1 || exit 1
+hint=$(nth_hint "$HELD_LOG" 'scale ' 1)
+expect_hint "$hint" "scale 240/120" "an uncommitted layer surface was not supersampled"
+sed -i 's/^supersample = true$/supersample = false/' "$UMBRIEL_CONFIG"
+"$UMBRIEL" msg config-reload > /dev/null
+printf 'map\n' >&5
+hint=$(nth_hint "$HELD_LOG" 'scale ' 2)
+echo "overlay layer mapped after the rule arrived: $hint"
+expect_hint "$hint" "scale 150/120" "a rule that arrived before the first commit did not reach the surface"
+
+echo "layer surfaces supersample by default, and a supersample layer rule reaches them on reload, at creation, and on the commit that maps them"
diff --git a/tests/harness/checks/protocol/xwayland_render_scale.sh b/tests/harness/checks/protocol/xwayland_render_scale.sh
new file mode 100644
index 00000000..e5ad1e52
--- /dev/null
+++ b/tests/harness/checks/protocol/xwayland_render_scale.sh
@@ -0,0 +1,150 @@
+#!/usr/bin/env bash
+# harness: xwayland=native
+# X11 clients that draw a fixed number of pixels must stay at native output
+# size unless forced X11 supersampling is explicitly enabled.
+set -euo pipefail
+source "$UMBRIEL_HARNESS_LIB"
+
+readonly EXPECT_SCALE=${UMBRIEL_X11_EXPECT_SCALE:-1.25}
+readonly EXPECT_WIDTH=${UMBRIEL_X11_EXPECT_WIDTH:-480}
+readonly EXPECT_HEIGHT=${UMBRIEL_X11_EXPECT_HEIGHT:-320}
+readonly EXPECT_RED_WIDTH=${UMBRIEL_X11_EXPECT_RED_WIDTH:-500}
+readonly EXPECT_RED_HEIGHT=${UMBRIEL_X11_EXPECT_RED_HEIGHT:-300}
+readonly EXPECT_RED_PIXELS=${UMBRIEL_X11_EXPECT_RED_PIXELS:-120000}
+readonly EXPECT_GDK_SCALE=${UMBRIEL_X11_EXPECT_GDK_SCALE:-1}
+readonly EXPECT_XFT_DPI=${UMBRIEL_X11_EXPECT_XFT_DPI:-122880}
+readonly EXPECT_OUTPUT_WIDTH=${UMBRIEL_X11_EXPECT_OUTPUT_WIDTH:-1280}
+readonly EXPECT_OUTPUT_HEIGHT=${UMBRIEL_X11_EXPECT_OUTPUT_HEIGHT:-960}
+readonly IMAGE="$UMBRIEL_RUNTIME_DIR/x11-render-scale.png"
+readonly CLIENT_LOG="$UMBRIEL_RUNTIME_DIR/x11-render-scale.log"
+
+cat >> "$UMBRIEL_CONFIG" <<'EOF'
+
+[animation]
+enabled = false
+[colors]
+backdrop = "#00FF00FF"
+[appearance]
+border_width = 0
+outer_border_width = 0
+corner_radius = 0
+[appearance.title_bar]
+mode = "off"
+[appearance.shadow]
+enabled = false
+[output."HEADLESS-1"]
+mode = "1280x960"
+scale = 1.25
+render_scale = 2.5
+[[window_rule]]
+match.title = "^x11-render-scale$"
+default_floating = true
+default_position = { x = 100, y = 240, anchor = "top_left" }
+EOF
+"$UMBRIEL" msg config-reload > /dev/null
+
+mkfifo "$UMBRIEL_RUNTIME_DIR/x11-render-scale.control"
+exec {client_fd}<>"$UMBRIEL_RUNTIME_DIR/x11-render-scale.control"
+"$UMBRIEL_XWAYLAND_SHAPE_CLIENT" x11-render-scale managed unshaped <&"$client_fd" >"$CLIENT_LOG" 2>&1 &
+client_pid=$!
+await_lines "$CLIENT_LOG" 'done mapped bounding=' 1
+
+expect_state() {
+  local window= width height settings= outputs= red_width=0 red_height=0 red_pixels=0
+  for _ in $(seq 80); do
+    window=$("$UMBRIEL" windows --json | jq -c '.[] | select(.title == "x11-render-scale")')
+    [[ -n $window ]] && break
+    sleep 0.025
+  done
+  [[ -n $window ]] || { echo "X11 client did not map"; return 1; }
+  read -r width height < <(jq -r '"\(.w) \(.h)"' <<< "$window")
+  if ((width != EXPECT_WIDTH || height != EXPECT_HEIGHT)); then
+    echo "X11 fixed-pixel window is ${width}x${height} logical; expected ${EXPECT_WIDTH}x${EXPECT_HEIGHT} at scale $EXPECT_SCALE"
+    return 1
+  fi
+
+  for _ in $(seq 80); do
+    settings=$("$UMBRIEL_XSETTINGS_CLIENT" 2>/dev/null) || true
+    [[ $settings == *"Gdk/WindowScalingFactor=$EXPECT_GDK_SCALE "* && $settings == *"Xft/DPI=$EXPECT_XFT_DPI"* ]] && break
+    sleep 0.025
+  done
+  if [[ $settings != *"Gdk/WindowScalingFactor=$EXPECT_GDK_SCALE "* || $settings != *"Xft/DPI=$EXPECT_XFT_DPI"* ]]; then
+    echo "XSETTINGS does not match the X11 scale: $settings"
+    return 1
+  fi
+
+  for _ in $(seq 80); do
+    outputs=$("$UMBRIEL_XWAYLAND_OUTPUT_CLIENT") || true
+    if jq -e --argjson w "$EXPECT_OUTPUT_WIDTH" --argjson h "$EXPECT_OUTPUT_HEIGHT" \
+      'any(.outputs[]; .name == "HEADLESS-1" and .w == $w and .h == $h)' <<< "$outputs" > /dev/null; then
+      break
+    fi
+    sleep 0.025
+  done
+  if ! jq -e --argjson w "$EXPECT_OUTPUT_WIDTH" --argjson h "$EXPECT_OUTPUT_HEIGHT" \
+    'any(.outputs[]; .name == "HEADLESS-1" and .w == $w and .h == $h)' <<< "$outputs" > /dev/null; then
+    echo "X11 output size differs: $outputs"
+    return 1
+  fi
+
+  "$UMBRIEL" settle > /dev/null
+  for _ in $(seq 80); do
+    grim -o HEADLESS-1 "$IMAGE"
+    read -r _ _ red_width red_height < <("$UMBRIEL_PIXEL_PROBE" "$IMAGE" bbox 'r > 0.9 && g < 0.1 && b < 0.1')
+    red_pixels=$("$UMBRIEL_PIXEL_PROBE" "$IMAGE" count 'r > 0.99 && g < 0.01 && b < 0.01')
+    if ((red_width == EXPECT_RED_WIDTH && red_height == EXPECT_RED_HEIGHT && red_pixels == EXPECT_RED_PIXELS)); then
+      break
+    fi
+    sleep 0.025
+  done
+  if ((red_width != EXPECT_RED_WIDTH || red_height != EXPECT_RED_HEIGHT || red_pixels != EXPECT_RED_PIXELS)); then
+    echo "X11 rendered red region is ${red_width}x${red_height}, $red_pixels solid pixels; expected ${EXPECT_RED_WIDTH}x${EXPECT_RED_HEIGHT}, $EXPECT_RED_PIXELS"
+    return 1
+  fi
+}
+
+expect_state
+if [[ $EXPECT_SCALE == 1.25 ]]; then
+  for render_scale in 1.25 0.5; do
+    sed -i "s/^render_scale = .*/render_scale = $render_scale/" "$UMBRIEL_CONFIG"
+    "$UMBRIEL" msg config-reload > /dev/null
+    expect_state
+  done
+  sed -i '/^\[general\]$/a force_x11_supersample = true' "$UMBRIEL_CONFIG"
+  "$UMBRIEL" msg config-reload > /dev/null
+  expect_state
+fi
+
+if [[ -n ${UMBRIEL_X11_RELOAD_TARGET:-} ]]; then
+  # Only render_scale changes: the mode and the logical scale stay put, so no
+  # output commit forces a layout refresh. The X rectangles must still follow.
+  sed -i "s/^render_scale = .*/render_scale = $UMBRIEL_X11_RELOAD_TARGET/" "$UMBRIEL_CONFIG"
+  "$UMBRIEL" msg config-reload > /dev/null
+  want_w=$(awk -v w=1280 -v s="$UMBRIEL_X11_RELOAD_TARGET" 'BEGIN { printf "%d", w * s / 1.25 }')
+  want_h=$(awk -v h=960 -v s="$UMBRIEL_X11_RELOAD_TARGET" 'BEGIN { printf "%d", h * s / 1.25 }')
+  for _ in $(seq 80); do
+    outputs=$("$UMBRIEL_XWAYLAND_OUTPUT_CLIENT") || true
+    jq -e --argjson w "$want_w" --argjson h "$want_h" \
+      'any(.outputs[]; .name == "HEADLESS-1" and .w == $w and .h == $h)' <<< "$outputs" > /dev/null && break
+    sleep 0.025
+  done
+  if ! jq -e --argjson w "$want_w" --argjson h "$want_h" \
+    'any(.outputs[]; .name == "HEADLESS-1" and .w == $w and .h == $h)' <<< "$outputs" > /dev/null; then
+    echo "X11 output size did not follow a render_scale-only reload (want ${want_w}x${want_h}): $outputs"
+    exit 1
+  fi
+  # The fixed-pixel X window keeps its X size; its logical size follows the mapping.
+  win_w=$(awk -v w=240 -v s="$UMBRIEL_X11_RELOAD_TARGET" 'BEGIN { printf "%d", w * 1.25 / s }')
+  win_h=$(awk -v h=160 -v s="$UMBRIEL_X11_RELOAD_TARGET" 'BEGIN { printf "%d", h * 1.25 / s }')
+  window=$("$UMBRIEL" windows --json | jq -c '.[] | select(.title == "x11-render-scale")')
+  read -r got_w got_h < <(jq -r '"\\(.w) \\(.h)"' <<< "$window")
+  if ((got_w != win_w || got_h != win_h)); then
+    echo "X11 window is ${got_w}x${got_h} logical after the reload; expected ${win_w}x${win_h}"
+    exit 1
+  fi
+fi
+
+printf 'quit\n' >&"$client_fd"
+wait "$client_pid"
+exec {client_fd}>&-
+echo "X11 window, native output pixels and XSETTINGS follow scale $EXPECT_SCALE"
