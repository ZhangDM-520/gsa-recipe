  git apply -3 ../0022-scratchpad-close-animation.patch

  # [scratchpad] showing a pad: the show path carried its own framing rule — a
  # presenting member whose centre fell outside the pad's usable area was
  # snapped to that area's exact centre — which contradicted the floating
  # margin 0003/PR #548 established, so a window legitimately hanging off an
  # output edge teleported on every show and every reopen. The rule is gone: a
  # show presents members where they are, a pad that changes output still
  # remaps them proportionally, and a member returning to an output that went
  # away is clamped to the grabbable margin like any other restore. Admission
  # keeps an arriving window in the pad's own basis only for an interactive
  # move into a pad already showing elsewhere. Three commits cut on
  # main@3898f805 and applied on top of 0011..0022; sha256 ec5f48e9…; the pin
  # is tests/harness/checks/scratchpad/reopen_keeps_position.sh.
  # (Retire on merge: 0023 -> the scratchpad show PR.)
  # Re-cut 2026-11-10 on main@8e13926a after the PR merge/convention round
  # (head 16bd15d4, 3 files +342/-23, sha256 99ff9ed7…).
  git apply -3 ../0023-scratchpad-show-no-recentre.patch

  # [cli] shell completion for the action/command grammar: `umbriel completions
  # <bash|zsh|fish>` prints a script and `umbriel complete -- <words>` answers it,
  # candidates coming from the tables the parsers already read so completion cannot
  # drift from parsing; live values stay inside a 120 ms budget. 31 files
  # +2681/-152, sha256 59d89e53…; the pins are tests/unit/completion.cpp and
  # session/action_dispatch. Cut on main@2de13d6a at 7c8b360d.
  # (Retire on merge: 0024 -> noctalia-dev/umbriel#806.)
  git apply -3 ../0024-cli-shell-completion.patch

  # [server] a launch names the process it created: one record replaces
  # `spawned '<cmd>'` and the pid-less scoped line, carrying label, `fork()` pid,
  # owning scope unit, and the command when it differs from the label, with the
  # label and command bounded by bytes so a long one cannot push the pid past the
  # 8 KiB log line cap. The two early failures move to kLog so they reach
  # `umbriel.log`. 4 files +72/-17; sha256 5edecb88…; the pin is session/spawn.
  # (Retire on merge: 0025 -> noctalia-dev/umbriel#820.)
  # History: 0025 carried the #801 status-plumbing fix until that PR was closed
  # as out of scope (a spawn handoff success is the shell's business); this
  # in-scope traceability change replaces it at the same index.
  git apply -3 ../0025-spawn-launch-record.patch

  # 0026 retired 2026-11-16: PR #800 merged upstream as 1bbbf155 (config diagnostic logging).

  # [render] drag-physics capture, animation backdrop reuse, and deformation
  # damage confinement: evaluate `FX_SLOT_DRAG` off-screen capture against
  # margins excluding the drag slot and add drawn margins only when capturing;
  # track draws per animation depth so an uncaptured depth-1 drag layer blends
  # directly onto the parent pass without two full-output backdrop copies (and
  # clip fallback clears/blends to the blur region); mark deformation bounded so
  # dragging preserves damage bounds and occluded `keep_input` culling.
  # Branch `fix/drag-blur-latency` at 7eedfc06 on main@1bbbf155 (9 files +453/-47,
  # sha256 0df919fc…); unit pins are `effects-drag-onscreen-capture`,
  # `effects-animation-backdrop-reuse`, and `effects-bounded-drag-confinement`.
  # (Retire on merge: 0027 -> noctalia-dev/umbriel#837.)
  git apply -3 ../0027-drag-blur-latency.patch

  # [render] size animation captures to bounds and reuse the deformed shadow
  # caster in one pass: replaces full-output captures with 128 px quantized
  # drawn-box targets (`fx_render_pass_begin_animation_box`), routes shadow H-blur
  # through a dedicated `animation_shadow_blur` pool slot so Stage 3 no longer
  # evicts `animation_buffers[1]` every frame, and composites `out_caster` once
  # over `drawn_box ∩ cached.box` with `output_sample` parity when
  # `shadow_capture_reusable` holds. Branch `fix/drag-physics-scalability` rebased
  # onto #837 (`7eedfc06..13336a64`, sha256 eb8890b7…); unit pins are
  # `effects-animation-box-capture` and `effects-animation-shadow-reuse`.
  # (Retire on merge: 0028 -> noctalia-dev/umbriel#840.)
  git apply -3 ../0028-drag-physics-scalability.patch

  # [render] size and manage blur offscreen buffers on demand: size
  # `effects_buffer` to `ceil(W/2) x ceil(H/2)` and `effects_buffer_swapped` to
  # `ceil(W/4) x ceil(H/4)` when fused (omitting swapped on 1-pass fused blur),
  # store half-res blur in `optimized_blur_buffer` with `blur_data_calc_size`
  # kernel halo and odd/even parity tracking, fuse final upsample via
  # `render_blur_composite`, defer/evict blur scratch when no visible blur
  # consumer exists, keep `optimized_no_blur_buffer` lazy for `< 1.0` strength,
  # isolate `capture_exclusion`, and un-cull occluded backdrops via sticky
  # `optimized_blur_evicted`. Branch `fix/vram-footprint` at 3c7c4d91 on
  # main@1bbbf155 (stacked onto 0027/0028 `compute_blur_sample_region`/
  # `animation_backdrop`/`suppress_capture_draws` in `fx_pass.c`; 7 files,
  # sha256 3e6686cc…); pins `color-blur-ping-pong-size`, `color-blur-scratch-lifecycle`.
  # (Retire on merge of follow-up VRAM PR.)
  git apply -3 ../0029-vram-blur-footprint.patch

  # [view] evaluate drag deformation surface with Horner's method: converts the
  # normalized 4x4 Bernstein control net to power coefficients once per uniform
  # update in `DragPhysics::normalizedPolynomial()` and reuses them per fragment
  # in `kDeformation`. Upstream PR noctalia-dev/umbriel#824 (`eedfe31c`, 5 files,
  # sha256 263c6908…); pin is `polynomialUniformsPreserveThePhysicalSheet`.
  # (Retire on merge: 0030 -> noctalia-dev/umbriel#824.)
  git apply -3 ../0030-drag-horner.patch
}

build() {

  local meson_flags=(
    -Db_ndebug=true
    -Djemalloc=enabled
  )

  # PGO (meson tier): instrument -> train -> use. The profile work dir sits
  # OUTSIDE the build dir (mesa precedent): DW_AT_comp_dir equals the build
  # dir, and the payload gate's literal predicate would otherwise risk
  # false-matching debug info.
  # Start the profile dir empty. A reused srcdir (makepkg --noextract) would
  # otherwise carry the previous revision's gcda into this build, and
  # -fprofile-use would read arc counts for code that no longer exists — the
  # -Wcoverage-mismatch shape, but silent and stale rather than expected.
  # Same idiom as mold-git.
  local _pgo_dir="$srcdir/pgo-profiles"
  rm -rf "$_pgo_dir"
  mkdir -p "$_pgo_dir"
  local _final_cflags="$CFLAGS"
  local _final_cxxflags="$CXXFLAGS"
  local _final_ldflags="$LDFLAGS"

  # Phase 1 strips -flto: generate-mode bookkeeping and LTO whole-program
  # codegen interact badly (same as the C-autotools tier). And
  # -fprofile-generate=<dir> must stay SYMMETRIC with phase 2's
  # -fprofile-use=<dir>: profiles are looked up as
  # <dir>/<mangled-object-path>.gcda, so a bare generate paired with
  # use=<dir> misses every profile and silently compiles a profile-less
  # build (2026-10-19 GCC probe; the xorg-xwayland-git spelling is such a
  # miss — see the maintainer's private warehouse, 2026-10-19).
  local _gen_cflags="" _gen_cxxflags="" _gen_ldflags="" _flag
  for _flag in $_final_cflags; do
    case "$_flag" in
      -flto*) ;;
      *) _gen_cflags+=" $_flag" ;;
    esac
  done
  for _flag in $_final_cxxflags; do
    case "$_flag" in
      -flto*) ;;
      *) _gen_cxxflags+=" $_flag" ;;
    esac
  done
  for _flag in $_final_ldflags; do
    case "$_flag" in
      -flto*) ;;
      *) _gen_ldflags+=" $_flag" ;;
    esac
  done

  CFLAGS="${_gen_cflags# } -fprofile-generate=$_pgo_dir"
  CXXFLAGS="${_gen_cxxflags# } -fprofile-generate=$_pgo_dir"
  LDFLAGS="${_gen_ldflags# } -fprofile-generate=$_pgo_dir"

  # -Dtests/-Dharness are enabled ONLY for the training phase: a release
  # build compiles nothing but the compositor and its data otherwise
  # (PACKAGING.md). Phase 2 switches them back off so no test or harness-IPC
  # target is even compiled into the final build.
  #
  # The dir is purged first: a reused srcdir (a plain `makepkg -f` retry)
  # still holds the previous run's build-release, and `meson setup` on a
  # configured dir only prints "Directory already configured." — the
  # instrument leg then reuses phase 2's profile-use options, produces no
  # gcda at all, and the floor guard silently falls back to a plain build.
  rm -rf build-release
  arch-meson "${_pkgname}" build-release "${meson_flags[@]}" \
    -Db_lto=false -Dtests=enabled -Dharness=enabled
  meson compile -C build-release

  # Training run: the upstream suite is the broadest coverage upstream ships
  # (the unit battery plus the umbrielfx checks). A failing trainer is
  # tolerated — the floor guard below turns a thin profile into a plain
  # build. The CLI paths always exit through main(), so they flush profile
  # data even when no test ran.
  pgo_train_meson build-release 120
  local _bin="build-release/${_pkgname}"
  "$_bin" config schema --json >/dev/null 2>&1 || true
  "$_bin" config validate -c "${_pkgname}/examples/config.toml" >/dev/null 2>&1 || true
  "$_bin" --version >/dev/null 2>&1 || true
  "$_bin" --help >/dev/null 2>&1 || true

  # Floor guard: pgo_min_gcda ≈ the minimum distinct translation units the
  # training must touch before a profile is worth trusting; at or below it
  # the profile is too thin and the recipe falls back to a plain (LTO-only)
  # build rather than shipping a half-trained one.
  local pgo_min_gcda=50
  local _gcda_count
  _gcda_count="$(find "$_pgo_dir" -name '*.gcda' 2>/dev/null | wc -l)"
  if (( _gcda_count < pgo_min_gcda )); then
    warning "PGO produced only %d gcda files — rebuilding plain (LTO only)" "$_gcda_count"
    CFLAGS="$_final_cflags"
    CXXFLAGS="$_final_cxxflags"
    LDFLAGS="$_final_ldflags"
    meson setup --buildtype=plain --reconfigure "${_pkgname}" build-release \
      -Dc_args="$CFLAGS" \
      -Dcpp_args="$CXXFLAGS" \
      -Dc_link_args="$LDFLAGS" \
      -Dcpp_link_args="$LDFLAGS"
    meson configure build-release -Db_lto=true -Dtests=disabled -Dharness=disabled
  else
    msg "PGO profile: %d gcda files — rebuilding with profile" "$_gcda_count"
    # Phase 2: profile-used build. Tolerance flags are load-bearing
    # (AGENTS.md §4): -Wno-error=missing-profile keeps a TU the training
    # never ran a warning instead of a hard error; -Wno-error=coverage-mismatch
    # downgrades GCC's arc-count mismatch the same way — those functions
    # compile without profile data, everything else keeps the real profile,
    # and the payload stays uninstrumented either way. The expected mismatch
    # here is structural: -Dharness=enabled is phase-1-only, so every
    # UMBRIEL_HARNESS block inside ipc.cpp (dispatchRequest,
    # notifyOutputFrame) changes that TU's arc counts between the legs. No
    # -fprofile-correction: the house pattern (cmake-git, glib2-git) does not
    # use it.
    CFLAGS="$_final_cflags -fprofile-use=$_pgo_dir -Wno-error=missing-profile -Wno-error=coverage-mismatch"
    CXXFLAGS="$_final_cxxflags -fprofile-use=$_pgo_dir -Wno-error=missing-profile -Wno-error=coverage-mismatch"
    LDFLAGS="$_final_ldflags"
    meson setup --buildtype=plain --reconfigure "${_pkgname}" build-release \
      -Dc_args="$CFLAGS" \
      -Dcpp_args="$CXXFLAGS" \
      -Dc_link_args="$LDFLAGS" \
      -Dcpp_link_args="$LDFLAGS"
    meson configure build-release -Db_lto=true -Dtests=disabled -Dharness=disabled
  fi

  meson compile -C build-release
}

package() {
  meson install -C build-release --destdir "${pkgdir}"

  # PACKAGING.md's installed layout: the MIT license travels in the upstream
  # tree and lands beside the payload.
  install -Dm644 "${_pkgname}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  # Fatal shared gate (lib/pgo.sh) — last statement on purpose: nothing may
  # be added to $pkgdir after the payload is verified. The extra literal is
  # this recipe's PGO work dir: a generate-flag leak would bake it into a
  # shipped binary.
  verify_no_profile_instrumentation "$pkgdir" "$srcdir/pgo-profiles"
}
